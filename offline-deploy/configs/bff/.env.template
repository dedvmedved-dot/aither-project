# .env.template — переменные окружения BFF (Portal)
# Скопируйте в portal/.env и заполните значения

# База данных портала
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=aither
PG_PASSWORD=CHANGE_ME
PG_DB=aither

# JWT
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_64_CHARS

# OAuth-провайдеры
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK=http://YOUR_IP/auth/github/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK=http://YOUR_IP/auth/google/callback

YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_CALLBACK=http://YOUR_IP/auth/yandex/callback

# Gateway (внутренний URL)
CORE_API=http://GATEWAY_NODE_IP:30900

# Биллинг
STARTER_TOKENS=100000
REFILL_TOKENS=100000
MAX_REFILLS=10

# LDAP (опционально)
LDAP_URL=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_SEARCH_BASE=
