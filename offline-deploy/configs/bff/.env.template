# ============================================================
# Aither Platform — Portal BFF environment (актуально 10.07.2026)
# ============================================================
# Скопируйте в .env и заполните реальными значениями

# ── OAuth-провайдеры ──
# GitHub OAuth App: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=https://YOUR_DOMAIN:10443/auth/github/callback

# Google OAuth: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://YOUR_DOMAIN:10443/auth/google/callback

# Яндекс OAuth: https://oauth.yandex.ru/
YANDEX_CLIENT_ID=your_yandex_client_id
YANDEX_CLIENT_SECRET=your_yandex_client_secret
YANDEX_REDIRECT_URI=https://YOUR_DOMAIN:10443/auth/yandex/callback

# ── Portal ──
PUBLIC_HOST=YOUR_DOMAIN
NODE_ENV=production
CORS_ORIGIN=https://YOUR_DOMAIN:10443
INVITE_CODE=your-invite-code

# ── Gateway (VPS1) ──
# BFF → Gateway для делегированных запросов (чаты, биллинг)
CORE_API=http://VPS1_IP:30900

# ── JWT ──
# Секрет для подписи сессионных токенов (HS256)
JWT_SECRET=your-jwt-secret-at-least-32-chars

# ── ЮKassa (опционально) ──
# YOOKASSA_SHOP_ID=your_shop_id
# YOOKASSA_SECRET=your_secret_key

# ── PostgreSQL (портал, локальный Docker) ──
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=portal
PG_PASSWORD=your-db-password
PG_DB=portal

# ── Delegation (RS256 JWT для Gateway) ──
# Приватный ключ из delegation/private.pem (одна строка)
DELEGATION_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----"
