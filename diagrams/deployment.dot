digraph DeploymentFlow {
    rankdir=TB;
    bgcolor="#ffffff";
    fontname="Helvetica";
    node [fontname="Helvetica", fontsize=10, style=filled, color="#555555"];
    edge [fontname="Helvetica", fontsize=8, color="#888888"];

    subgraph cluster_deploy {
        label="Deployment: vllm-qwen-direct";
        fontcolor="#333333"; color="#cccccc"; bgcolor="#f3e5f5";
        ds [label="Deployment\nreplicas: 1", shape=box, fillcolor="#e1bee7", fontcolor="#7b1fa2", color="#8e24aa"];
        rs [label="ReplicaSet", shape=box, fillcolor="#f3e5f5", fontcolor="#7b1fa2", color="#ce93d8"];
    }
    
    subgraph cluster_pod {
        label="Pod (10.244.0.x)";
        fontcolor="#333333"; color="#cccccc"; bgcolor="#e3f2fd";
        container [label="Container: vllm\nvllm/vllm-openai:latest (0.24.0)\nport: 8000", shape=box, fillcolor="#bbdefb", fontcolor="#1565c0", color="#1e88e5"];
        models [label="/models\n← /data/models", shape=folder, fillcolor="#e0e0e0", fontcolor="#424242"];
        cpu [label="CPU: 8/16", shape=note, fillcolor="#e0e0e0", fontcolor="#424242"];
        ram [label="RAM: 24G/48G", shape=note, fillcolor="#e0e0e0", fontcolor="#424242"];
    }
    
    subgraph cluster_gpu {
        label="GPU (nodeSelector)";
        fontcolor="#333333"; color="#cccccc"; bgcolor="#ffebee";
        gpu0 [label="GPU 0\n14 GB весов", shape=box, fillcolor="#ffcdd2", fontcolor="#c62828", color="#e53935"];
        gpu1 [label="GPU 1\n14 GB весов", shape=box, fillcolor="#ffcdd2", fontcolor="#c62828", color="#e53935"];
    }
    
    svc [label="Service: vllm-qwen-direct\nClusterIP :8000", shape=box, fillcolor="#fff3e0", fontcolor="#e65100", color="#fb8c00"];
    
    ds -> rs;
    rs -> container;
    container -> models;
    container -> gpu0 [label=" TP=2", color="#e53935", style=dashed];
    container -> gpu1 [label=" TP=2", color="#e53935", style=dashed];
    svc -> container [label=" :8000", color="#1e88e5", dir=back];
}
