digraph Architecture {
    rankdir=TB;
    bgcolor="#ffffff";
    fontname="Helvetica";
    
    node [fontname="Helvetica", fontsize=10, style="filled", color="#333333"];
    edge [fontname="Helvetica", fontsize=8, color="#666666"];

    subgraph cluster_internet {
        label="Интернет";
        fontcolor="#333333";
        color="#999999";
        bgcolor="#f5f5f5";
        
        tg [label="Telegram API\n(пользователи)", shape=cloud, fillcolor="#e3f2fd", fontcolor="#1565c0", color="#1e88e5"];
    }
    
    subgraph cluster_vps1 {
        label="VPS1 (170.168.91.95) — Публичный шлюз";
        fontcolor="#333333";
        color="#cccccc";
        bgcolor="#fafafa";
        
        hermes [label="Hermes Agent\n(Telegram Bot)", shape=box, fillcolor="#c8e6c9", fontcolor="#2e7d32", color="#43a047"];
        gateway [label="Gateway :30900\n(маршрутизация)", shape=box, fillcolor="#bbdefb", fontcolor="#1565c0", color="#1e88e5"];
        portal [label="Aither Portal\n(:80, веб-интерфейс)", shape=box, fillcolor="#fff3e0", fontcolor="#e65100", color="#fb8c00"];
    }
    
    subgraph cluster_vps2 {
        label="VPS2 (130.17.1.90) — Прокси";
        fontcolor="#333333";
        color="#cccccc";
        bgcolor="#fafafa";
        
        proxy [label="SSH-прокси\nХранилище моделей", shape=box, fillcolor="#e1bee7", fontcolor="#7b1fa2", color="#8e24aa"];
    }
    
    subgraph cluster_k8s {
        label="40.51 (10.129.13.78) — K8s GPU-кластер";
        fontcolor="#333333";
        color="#cccccc";
        bgcolor="#fafafa";
        
        subgraph cluster_gpu {
            label="GPU Node";
            fontcolor="#333333";
            color="#e0e0e0";
            bgcolor="#fff8e1";
            
            qwen [label="vLLM Qwen 14B\nTP=2, :8000", shape=box, fillcolor="#ffcdd2", fontcolor="#c62828", color="#e53935"];
            gpu0 [label="GPU 0\n24 GB", shape=box, fillcolor="#ffcdd2", fontcolor="#c62828", color="#e53935"];
            gpu1 [label="GPU 1\n24 GB", shape=box, fillcolor="#ffcdd2", fontcolor="#c62828", color="#e53935"];
        }
        
        postgres [label="PostgreSQL", shape=cylinder, fillcolor="#b3e5fc", fontcolor="#0277bd", color="#0288d1"];
        redis [label="Redis", shape=cylinder, fillcolor="#ffccbc", fontcolor="#bf360c", color="#e64a19"];
        svc [label="Service\n(vllm-qwen-direct)", shape=box, fillcolor="#e0e0e0", fontcolor="#424242", color="#9e9e9e"];
    }
    
    tg -> hermes [label=" Webhook", color="#1e88e5"];
    hermes -> gateway [label=" Маршрутизация", color="#43a047"];
    gateway -> proxy [label=" WireGuard", color="#7b1fa2", style=dashed];
    proxy -> svc [label=" kubectl", color="#7b1fa2", style=dashed];
    svc -> qwen [label=" :8000", color="#1e88e5"];
    qwen -> gpu0 [label=" TP=2", color="#e53935"];
    qwen -> gpu1 [label=" TP=2", color="#e53935"];
    gateway -> portal [label=" API", color="#fb8c00"];
    portal -> postgres [style=dotted, color="#9e9e9e"];
    portal -> redis [style=dotted, color="#9e9e9e"];
}
