digraph CBWebUIDualZone {
    rankdir=TB;
    bgcolor="#ffffff";
    fontname="Helvetica";
    label="Aither Closed Beta — Dual-Zone Web UI Architecture";

    node [fontname="Helvetica", fontsize=10, style="filled", color="#333333"];
    edge [fontname="Helvetica", fontsize=8, color="#666666"];

    // =====================================================================
    // Зона: Интернет
    // =====================================================================
    subgraph cluster_internet {
        label="Зона: Интернет";
        fontcolor="#333333";
        color="#e53935";
        bgcolor="#fff5f5";
        penwidth=2;

        internet_user [label="User Browser\n(Internet)", shape=box, fillcolor="#ffcdd2", fontcolor="#c62828", color="#e53935"];
    }

    // =====================================================================
    // Зона: VPS2 — Публичный шлюз
    // =====================================================================
    subgraph cluster_vps2 {
        label="Зона: VPS2 (публичный шлюз, host network)";
        fontcolor="#333333";
        color="#fb8c00";
        bgcolor="#fff8e1";
        penwidth=2;

        vps2_nginx [label="nginx\n:443 (HTTPS, TLS)\nПрокси на K8s", shape=box, fillcolor="#ffe0b2", fontcolor="#e65100", color="#fb8c00"];
    }

    // =====================================================================
    // Зона: Тестовая (внутренняя сеть 10.129.13.0/24)
    // =====================================================================
    subgraph cluster_testzone {
        label="Зона: Тестовая (10.129.13.0/24)";
        fontcolor="#333333";
        color="#1e88e5";
        bgcolor="#f5f8ff";
        penwidth=2;

        testzone_user [label="User Browser\n(Test Zone)", shape=box, fillcolor="#bbdefb", fontcolor="#1565c0", color="#1e88e5"];

        // =================================================================
        // K8s кластер
        // =================================================================
        subgraph cluster_k8s {
            label="Kubernetes Cluster\n(n7-gpu: 10.129.13.77, n8-gpu: 10.129.13.78)";
            fontcolor="#333333";
            color="#43a047";
            bgcolor="#f1f8e9";
            penwidth=2;

            // NodePort — точка входа
            nodeport [label="NodePort\n:30080", shape=box, fillcolor="#c8e6c9", fontcolor="#2e7d32", color="#43a047"];

            // Pod aither-portal
            subgraph cluster_portal_pod {
                label="Pod: aither-portal";
                fontcolor="#333333";
                color="#66bb6a";
                bgcolor="#e8f5e9";

                portal_nginx [label="nginx\n(SPA + reverse proxy)", shape=box, fillcolor="#a5d6a7", fontcolor="#1b5e20", color="#43a047"];
                portal_spa [label="SPA\n(Vanilla JS)", shape=note, fillcolor="#c8e6c9", fontcolor="#2e7d32", color="#66bb6a"];
            }

            // BFF
            bff [label="BFF\n(Python FastAPI)\n:8000", shape=box, fillcolor="#fff3e0", fontcolor="#e65100", color="#fb8c00"];

            // Identity
            identity [label="Identity Service\n(K8s Secret\nadmin credentials)", shape=box, fillcolor="#e1bee7", fontcolor="#7b1fa2", color="#8e24aa"];

            // Redis
            redis [label="Redis\n(aither-redis-rate-limit)\nСессии / Rate Limit", shape=cylinder, fillcolor="#ffccbc", fontcolor="#bf360c", color="#e64a19"];

            // AI Platform (gateway/abstraction)
            ai_platform [label="AI Platform\n(маршрутизация\nзапросов)", shape=box, fillcolor="#b3e5fc", fontcolor="#0277bd", color="#0288d1"];

            // vLLM модели
            subgraph cluster_models {
                label="Модели vLLM";
                fontcolor="#333333";
                color="#bdbdbd";
                bgcolor="#fafafa";

                vllm_14b [label="vLLM 14B\nvllm-14b-instruct\nchat", shape=box, fillcolor="#ffcdd2", fontcolor="#c62828", color="#e53935"];
                vllm_32b [label="vLLM 32B\nvllm-32b-gptq\nchat-adapter\ncompletion", shape=box, fillcolor="#ffcdd2", fontcolor="#c62828", color="#e53935"];
            }
        }
    }

    // =====================================================================
    // Маршруты: Интернет
    // =====================================================================
    internet_user -> vps2_nginx [label=" HTTPS :443", color="#e53935", fontcolor="#c62828"];
    vps2_nginx -> nodeport [label=" :30080\n(через внутреннюю сеть)", color="#fb8c00", fontcolor="#e65100"];

    // =====================================================================
    // Маршруты: Тестовая Зона
    // =====================================================================
    testzone_user -> nodeport [label=" HTTP :30080\n(внутренняя сеть)", color="#1e88e5", fontcolor="#1565c0"];

    // =====================================================================
    // Внутри K8s
    // =====================================================================
    nodeport -> portal_nginx [label="", color="#43a047"];
    portal_nginx -> portal_spa [label=" статика", color="#66bb6a", style=dotted];
    portal_nginx -> bff [label=" /api/*", color="#43a047"];

    // BFF ↔ инфраструктура
    bff -> identity [label=" аутентификация", color="#7b1fa2", style=dashed];
    bff -> redis [label=" сессии\n  rate limit", color="#e64a19", style=dotted];
    bff -> ai_platform [label=" запросы\n  к моделям", color="#0277bd"];

    // AI Platform → модели
    ai_platform -> vllm_14b [label=" model:14b:chat", color="#c62828", fontcolor="#c62828"];
    ai_platform -> vllm_32b [label=" model:32b:chat-adapter\n model:32b:completion", color="#c62828", fontcolor="#c62828"];

    // =====================================================================
    // Легенда: Scopes
    // =====================================================================
    subgraph cluster_legend {
        label="Scopes (области действия токенов)";
        fontcolor="#333333";
        color="#9e9e9e";
        bgcolor="#fafafa";

        scope_chat [label="model:14b:chat\n→ vLLM 14B", shape=note, fillcolor="#ffcdd2", fontcolor="#c62828", color="#e53935", fontsize=9];
        scope_adapter [label="model:32b:chat-adapter\n→ vLLM 32B (chat)", shape=note, fillcolor="#ffcdd2", fontcolor="#c62828", color="#e53935", fontsize=9];
        scope_compl [label="model:32b:completion\n→ vLLM 32B (compl)", shape=note, fillcolor="#ffcdd2", fontcolor="#c62828", color="#e53935", fontsize=9];

        scope_chat -> scope_adapter -> scope_compl [style=invis];
    }
}
