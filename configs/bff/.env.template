# Aither Portal BFF — переменные окружения (шаблон)
# Версия: v1.1.0 (10.07.2026)
# Скопировать в /root/aither-project/portal/.env и заполнить значения

# === База данных ===
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=portal
PG_PASSWORD=<пароль-БД>

# === Административный доступ ===
ADMIN_KEY=<admin-ключ-для-панели-управления>

# === JWT ===
JWT_SECRET=<секрет-для-подписи-токенов>

# === Gateway (Core API) ===
CORE_API=http://10.129.13.78:30900/v1
# Альтернативно через VPS1 прокси:
# CORE_API=https://fb1.spb.ru:10443/v1

# === OAuth ===
GITHUB_CLIENT_ID=<github-client-id>
GITHUB_CLIENT_SECRET=<github-client-secret>
GITHUB_CALLBACK_URL=https://fb1.spb.ru:10443/auth/github/callback

GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>
GOOGLE_CALLBACK_URL=https://fb1.spb.ru:10443/auth/google/callback

YANDEX_CLIENT_ID=<yandex-client-id>
YANDEX_CLIENT_SECRET=<yandex-client-secret>
YANDEX_CALLBACK_URL=https://fb1.spb.ru:10443/auth/yandex/callback

# === LDAP (настраивается также через админ-панель 🔧 Настройки) ===
# Приоритет: значения из БД portal_settings переопределяют .env
LDAP_URL=ldap://freeipa.example.com:389
LDAP_BASE_DN=dc=example,dc=com
LDAP_BIND_DN=uid=svc,cn=users,cn=accounts,dc=example,dc=com
LDAP_BIND_PASSWORD=<пароль-сервисной-учётки>
LDAP_USER_BASE=cn=users,cn=accounts,dc=example,dc=com
LDAP_GROUP_BASE=cn=groups,cn=accounts,dc=example,dc=com
LDAP_UID_ATTR=uid
LDAP_MAIL_ATTR=mail
LDAP_NAME_ATTR=displayName

# === ЮKassa (платежи) ===
YOOKASSA_SHOP_ID=<shop-id>
YOOKASSA_SECRET=<секрет-юкассы>

# === Хост ===
PUBLIC_HOST=fb1.spb.ru
PORT=3000
NODE_ENV=production

# === Биллинг ===
STARTER_TOKENS=100000
