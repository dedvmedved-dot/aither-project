#!/bin/bash
# Pre-commit secret scan — blocks commits containing secrets

echo "🔍 Secret scan..."

EXIT_CODE=0

# Patterns to detect
PATTERNS=(
    '-----BEGIN RSA PRIVATE KEY-----'
    '-----BEGIN PRIVATE KEY-----'
    '-----BEGIN EC PRIVATE KEY-----'
    '-----BEGIN DSA PRIVATE KEY-----'
    '-----BEGIN OPENSSH PRIVATE KEY-----'
    'verify=False'
    'verify=false'
    'InsecureRequestWarning'
    'curl -k'
    'aither_[a-f0-9]{8}_[A-Za-z0-9_-]{43}'
)

# Get files staged for commit
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    echo "✅ No files staged"
    exit 0
fi

for pattern in "${PATTERNS[@]}"; do
    FOUND=$(echo "$STAGED_FILES" | xargs -r grep -l "$pattern" 2>/dev/null)
    if [ -n "$FOUND" ]; then
        echo "❌ BLOCKED: '$pattern' found in:"
        echo "$FOUND" | sed 's/^/    /'
        EXIT_CODE=1
    fi
done

# Check for .pem files that might be private keys
PEM_FILES=$(echo "$STAGED_FILES" | grep '\.pem$')
if [ -n "$PEM_FILES" ]; then
    for f in $PEM_FILES; do
        if head -1 "$f" | grep -q "PRIVATE KEY"; then
            echo "❌ BLOCKED: Private key in $f"
            EXIT_CODE=1
        fi
    done
fi

if [ $EXIT_CODE -eq 0 ]; then
    echo "✅ Secret scan passed"
else
    echo ""
    echo "Commit blocked. Remove secrets and try again."
fi

exit $EXIT_CODE
