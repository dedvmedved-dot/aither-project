{
  "__inputs": [],
  "__requires": [],
  "annotations": { "list": [] },
  "editable": true,
  "gnetId": null,
  "graphTooltip": 0,
  "hideControls": false,
  "id": null,
  "links": [],
  "tags": ["aither", "observability", "stage17", "identity"],
  "title": "Aither — Identity",
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "panels": [
    {
      "id": 1,
      "title": "Active Users",
      "type": "stat",
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "none" }
      },
      "targets": [
        {"expr": "identity_active_users", "legendFormat": "Active Users"}
      ],
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "Request Rate",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "rate(http_requests_total{service=\"identity\"}[5m])", "legendFormat": "{{endpoint}}"}
      ],
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 4 }
    },
    {
      "id": 3,
      "title": "Latency (ms)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "targets": [
        {"expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service=\"identity\"}[5m])) by (le))", "legendFormat": "P95"},
        {"expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{service=\"identity\"}[5m])) by (le))", "legendFormat": "P50"}
      ],
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 10 }
    },
    {
      "id": 4,
      "title": "Login Errors",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "rate(errors_total{service=\"identity\",type=\"login_failed\"}[5m])", "legendFormat": "Login Failures"}
      ],
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 16 }
    }
  ]
}
