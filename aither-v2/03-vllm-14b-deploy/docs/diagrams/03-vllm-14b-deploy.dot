// Этап 3: vLLM — компоненты и связи
// Сохранено: docs/diagrams/03-vllm-14b-deploy.dot
// Визуализация: dot -Tpng docs/diagrams/03-vllm-14b-deploy.dot -o docs/diagrams/03-vllm-14b-deploy.png

digraph G {
    rankdir=LR;
    splines=ortho;
    node [shape=box, style=rounded];
    ranksep=1.2;
    fontname="Helvetica";

    subgraph cluster_legend {
        label="Легенда";
        color=lightgrey;
        running [label="— работает", shape=box, style=filled, fillcolor=green, fontcolor=white];
        planned [label="— запланировано", shape=box, style=dashed];
        fallback [label="— fallback (CPU offload)", shape=box, style=filled, fillcolor=orange, fontcolor=white];
    }

    subgraph cluster_cluster {
        label="Kubernetes — aither-inference + default";

        ns [label="Namespace: aither-inference", shape=component, style=filled, fillcolor=lightyellow];
        sa [label="SA: vllm-sa", shape=box, style=filled, fillcolor=lightyellow];

        svc [label="Service: vllm-api\nClusterIP :8000, :8001", shape=box3d, style=filled, fillcolor=lightblue];

        subgraph cluster_n8 {
            label="Узел n8 — 2× RTX 6000 23GB (CC 7.5)";
            color=green;
            
            n8_models [label="/data/models/\nCoder-14B ✅\n14B-Instruct ✅\n32B-GPTQ ✅", shape=folder, style=filled, fillcolor=lightgrey];

            n8_coder [label="Pod: vllm-coder-14b (default NS)\nQwen2.5-Coder-14B-Instruct\nTP=2, GPU 0+1\nport 8000", shape=box, style=filled, fillcolor=green, fontcolor=white];
            n8_coder_attn [label="Attention: XFormers\ndtype: half | Engine: V0", shape=note, style=filled, fillcolor=lightgreen];

            n8_models -> n8_coder [label="загружает веса", style=dashed];
            n8_coder -> n8_coder_attn;
        }

        subgraph cluster_n7 {
            label="Узел n7 — 2× RTX 6000 23GB (CC 7.5)";
            color=orange;

            n7_models [label="/data/models/\n32B-GPTQ ✅\n14B-Instruct ⚠️", shape=folder, style=filled, fillcolor=lightgrey];

            n7_32b [label="Deployment: vllm-32b-gptq\nQwen2.5-32B-GPTQ\nTP=1, GPU 0\nport 8001\n~10GB VRAM", shape=box, style=filled, fillcolor=orange, fontcolor=white, style=dashed];
            n7_14b [label="Deployment: vllm-14b-instruct\nQwen2.5-14B-Instruct\nTP=1, GPU 0, CPU offload 4GB\nport 8000\n~21GB VRAM", shape=box, style=filled, fillcolor=orange, style=dashed];

            n7_models -> n7_32b [label="загружает веса", style=dashed, color=gray];
            n7_models -> n7_14b [label="загружает веса", style=dashed, color=gray];
        }
    }

    // Внешние связи
    subgraph cluster_upstream {
        label="Следующие этапы";
        gateway [label="Этап 5: Gateway + Redis\nпрокси /v1/completions", shape=box, style=filled, fillcolor=lightgrey, fontcolor=gray];
        tp [label="Этап 4: Tensor Parallelism\nмежсерверный TP=2", shape=box, style=dashed, fillcolor=lightgrey, fontcolor=gray];
    }

    ns -> sa [style=dashed];
    ns -> svc [style=dashed];
    svc -> n8_coder [label="балансировка :8000", style=dashed];
    svc -> n7_14b [label="балансировка :8000", style=dashed, color=gray];
    svc -> n7_32b [label="балансировка :8001", style=dashed, color=gray];
    gateway -> n8_coder [label="прокси /v1/*", style=dotted, color=blue];
    gateway -> n7_32b [label="прокси /v1/*", style=dotted, color=gray];
    tp -> n7_32b [label="будущее: TP=2", style=dotted, color=gray];
}
