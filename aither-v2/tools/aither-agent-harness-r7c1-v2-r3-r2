def scenario_relevant_types(scenario):
    """Semantic relevance set for a scenario (domain family + evidence op types)."""
    ev_types = {e["operation"]["type"] for e in scenario.get("evidence", []) if "operation" in e}
    return DOMAIN_RELEVANT_TYPES.get(scenario.get("domain", ""), set()) | ev_types

# ---------------------------------------------------------------------------
# Normalization helpers (safe only)
# ---------------------------------------------------------------------------
def norm_service(s):
    """Exact suffix normalization: only strip the complete '.service' suffix.

    R1-2 fix: rstrip('.service') corrupted 'worker'->'work', 'docker'->'dock',
    'redis'->'red', 'service'->''. Use exact suffix handling instead."""
    s = (s or "").lower().strip()
    if s.endswith(".service"):
        s = s[:-len(".service")]
    return s

def norm_pod(p):
    p = (p or "").lower().strip()
    return re.sub(r"-[a-z0-9]{8,10}-[a-z0-9]{5}$", "", p)

def norm_resource(r):
    r = (r or "").lower().strip()
    return "pods" if r in ("pod", "pods") else r

def norm_path(p):
    return (p or "").lstrip("/")

def norm_hostname(h):
    return (h or "").lower().strip().rstrip(".")

def norm_url(u):
    return (u or "").rstrip("/")

def norm_repo(r):
    return (r or "").lower().strip()

def _canon_query(q):
    """Canonical SQL query form for semantic comparison (lowercase, collapse whitespace)."""
    return re.sub(r"\s+", " ", (q or "").lower().strip())

# ---------------------------------------------------------------------------
# Semantic final-answer evaluator (M5) — typed semantic concepts + deterministic
# general aliases. Replaces narrow exact substring matching with a
# stopword-tolerant token-subsequence matcher over a concept alias map.
# Aliases are GENERAL paraphrases/synonyms — no model-specific exceptions.
# ---------------------------------------------------------------------------
STOPWORDS = {
    "the", "a", "an", "of", "to", "for", "on", "in", "at", "and", "or", "is", "are",
    "was", "were", "be", "been", "being", "that", "which", "by", "with", "from", "its",
    "it", "as", "into", "onto", "using", "via", "about", "this", "these", "those", "has",
    "have", "had", "will", "would", "should", "could", "can", "may", "might", "must",
    "do", "does", "did", "not", "no", "any", "some", "all", "each", "per", "then", "so",
}

def _norm(s):
    s = (s or "").lower()
    s = re.sub(r"[^\w/\-\.]", " ", s)
    return " ".join(t for t in s.split() if t not in STOPWORDS)

def _tokens(s):
    return _norm(s).split()

def _alias_matches(tt, alias):
    """Deterministic alias match over a token stream (tt)."""
    at = _tokens(alias)
    if not at:
        return False
    # single pure-alphanumeric token: word-boundary match to avoid substring FPs
    if len(at) == 1 and re.fullmatch(r"[a-z0-9]+", at[0]):
        joined = " ".join(tt)
        return re.search(r"(?<![a-z0-9])" + re.escape(at[0]) + r"(?![a-z0-9])", joined) is not None
    # multi-token: ordered subsequence (allows intervening content words between
    # alias tokens, e.g. "increase the memory limit" vs "increase memory")
    pos = 0
    for a in at:
        while pos < len(tt) and tt[pos] != a:
            pos += 1
        if pos >= len(tt):
            return False
        pos += 1
    return True

