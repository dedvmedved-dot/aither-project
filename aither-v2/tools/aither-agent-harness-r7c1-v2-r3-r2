# Router P0 (prompt text only) — reused from v1 semantics
# ---------------------------------------------------------------------------
P0_RULES = [
    (re.compile(r"kubernetes|pod|deployment|pvc|helm|container|k8s|coredns", re.I), ["KUBERNETES"]),
    (re.compile(r"dns|hostname|resolve|tls|http|proxy|502|nxdomain", re.I), ["NETWORK"]),
    (re.compile(r"systemd|service|journal|docker daemon|ceph|drbd|osd|pg |vm|libvirt|cron|process|disk|memory|oom", re.I), ["LINUX"]),
    (re.compile(r"git |commit|diff|branch|repo", re.I), ["GIT"]),
    (re.compile(r"file|yaml|json|config|playbook|script|ansible|jq|helm values", re.I), ["FILES"]),
]
def route_p0(prompt):
    g = []
    for rx, grps in P0_RULES:
        if rx.search(prompt):
            for x in grps:
                if x not in g:
                    g.append(x)
    return g or list(GROUPS)


def operation_to_args(tool, op):
    """Reverse mapping: operation -> (tool, args) for the scripted positive agent."""
    t = op["type"]
    m = {"read_file": "read_file", "list_directory": "list_directory", "grep_search": "grep_search",
         "service_status": "systemctl_status", "journal_read": "journalctl_read",
         "kube_get": "kubectl_get", "kube_describe": "kubectl_describe", "kube_logs": "kubectl_logs",
         "git_status": "git_status", "git_diff": "git_diff", "git_show": "git_show",
         "http_get": "http_get", "dns_lookup": "dns_lookup"}
    if t in m:
        tool2 = m[t]
        if t in ("read_file", "list_directory", "read_file_via_shell", "certificate_expiry", "list_file"):
            return tool2, {"path": "/" + op["path"] if not op["path"].startswith("/") else op["path"]}
        if t in ("service_status", "journal_read"):
            return tool2, {"service": op["service"]}
        if t == "kube_get":
            return tool2, {"resource": op["resource"], "namespace": op["namespace"]}
        if t in ("kube_describe", "kube_logs"):
            return tool2, {"pod": op["pod"], "namespace": op["namespace"]}
        if t in ("git_status", "git_diff"):
            return tool2, {"repo": op["repo"]}
        if t == "git_show":
            return tool2, {"repo": op["repo"], "commit": op["commit"]}
        if t == "http_get":
            return tool2, {"url": op["url"]}
        if t == "dns_lookup":
            return tool2, {"hostname": op["hostname"]}
        if t == "grep_search":
            return tool2, {"pattern": op["pattern"], "path": op["path"]}
    # shell ops -> reconstruct canonical command
    if t == "disk_usage_filesystem":
        return "shell_readonly", {"command": "df -h" if op["target"] == "*" else f"df -h {op['target']}"}
    if t == "disk_usage_directory":
        return "shell_readonly", {"command": f"du -sh {op['target']}/*"}
    if t == "crontab_list":
        return "shell_readonly", {"command": "crontab -l"}
    if t == "read_file_via_shell":
        return "shell_readonly", {"command": f"cat {op['path']}"}
    if t == "certificate_expiry":
        return "shell_readonly", {"command": f"openssl x509 -enddate -noout -in {op['path']}"}
    if t == "kube_endpoints":
        return "shell_readonly", {"command": f"kubectl get endpoints {op['service']}"}
    if t == "docker_exec_dns":
        # R3-R1: emit the specific host when known; omit only for the true "all" query
        host = op.get("host", "*")
        cmd = f"docker exec {op['container']} nslookup"
        if host and host != "*":
            cmd += f" {host}"
        return "shell_readonly", {"command": cmd}
    if t == "docker_images":
        return "shell_readonly", {"command": "docker images"}
    if t == "docker_build":
        return "shell_readonly", {"command": f"docker build -t {op['tag']} {op.get('path','.')}"}
    if t == "ceph_status":
        return "shell_readonly", {"command": "ceph -s"}
    if t == "ceph_osd_tree":
        return "shell_readonly", {"command": "ceph osd tree"}
    if t == "ceph_pg_stat":
        return "shell_readonly", {"command": "ceph pg stat"}
    if t == "drbd_status":
        return "shell_readonly", {"command": f"drbdadm status {op['resource']}"}
    if t == "drbd_role":
        return "shell_readonly", {"command": f"drbdadm role {op['resource']}"}
    if t == "ceph_osd_df":
        return "shell_readonly", {"command": "ceph osd df"}
    if t == "ceph_pg_dump":
        return "shell_readonly", {"command": "ceph pg dump"}
    if t == "ceph_health_detail":
        return "shell_readonly", {"command": "ceph health detail"}
    if t == "mounts":
        return "shell_readonly", {"command": "mount"}
    if t == "ip_link":
        iface = op.get("interface", "*")
        return "shell_readonly", {"command": "ip link" if iface == "*" else f"ip -s link show {iface}"}
    if t == "dns_query":
        return "shell_readonly", {"command": f"dig {op['hostname']}"}
    if t == "psql_query":
        return "shell_readonly", {"command": f"psql -c '{op['query']}'"}
    if t == "lscpu":
        return "shell_readonly", {"command": "lscpu"}
    if t == "http_get_via_shell":
        return "shell_readonly", {"command": f"curl -s {op['url']}"}
    if t == "nvidia_smi":
        return "shell_readonly", {"command": "nvidia-smi --query-gpu=name,memory.total --format=csv"}
    if t == "socket_listeners":
        if op.get("port"):
            return "shell_readonly", {"command": f"ss -ltnp | grep ':{op['port']}'"}
        return "shell_readonly", {"command": "ss -ltnp"}
    if t == "process_list":
        return "shell_readonly", {"command": "ps aux" if op["pattern"] == "*" else f"ps aux | grep {op['pattern']}"}
    if t == "list_file":
        return "shell_readonly", {"command": f"ls -l {op['path']}"}
    if t == "id":
        return "shell_readonly", {"command": "id"}
    return "shell_readonly", {"command": ""}


