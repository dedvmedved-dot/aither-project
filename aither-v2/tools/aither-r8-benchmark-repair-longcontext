def build_context(case):
    """Build a long context with begin/mid/end needles + filler (no tokenizer)."""
    facts = case["facts"]
    begin, mid, end = facts[0], facts[1], facts[2]
    head = f"=== SPEC ===\nservice: {case['id']}\n# {begin[2]}: {begin[3]}\n"
    filler_mid = "=== LOGS ===\n" + "\n".join(f"2026-08-01T00:00:00Z n1 svc[{i}]: INFO ok" for i in range(400))
    midsec = f"\n# {mid[2]}: {mid[3]}\n" + filler_mid
    endsec = f"\n# {end[2]}: {end[3]}\n"
    return head + midsec + endsec


def verify_markers(case, text):
    """Verify begin/mid/end marker positions are in the correct regions."""
    res = {}
    for fid, pos, marker, fact, tool, op in case["facts"]:
        idx = text.find(marker)
        frac = idx / max(1, len(text)) if idx >= 0 else -1
        res[fid] = {"found": idx >= 0, "frac": round(frac, 3)}
    return res


def main():
    out = sys.argv[1]
    rows = []
    for case in CASES:
        text = build_context(case)
        markers = verify_markers(case, text)
        # marker placement: begin < 0.1, mid in 0.2..0.8, end > 0.8
        begin_ok = markers["E1"]["found"] and markers["E1"]["frac"] < 0.1
        mid_ok = markers["E2"]["found"] and 0.2 <= markers["E2"]["frac"] <= 0.8
        end_ok = markers["E3"]["found"] and markers["E3"]["frac"] > 0.8

        # scripted agent: call each fact's tool, collect evidence
        sc = {"scenario_id": case["id"], "evidence": [],
              "root_concepts": case["root"], "rejected": case["rejected"],
              "required_evidence": [f[0] for f in case["facts"]],
              "causal_evidence": [case["facts"][0][0]],
              "remediation_class": case["remediation"], "prohibited": case["prohibited"]}
        for fid, pos, marker, fact, tool, op in case["facts"]:
            sc["evidence"].append({"id": fid, "tool": tool, "operation": op,
                                   "result": {"text": fact}})

        revealed = set()
        seen = set()
        calls = []
        for fid, pos, marker, fact, tool, op in case["facts"]:
            t2, a2 = H.operation_to_args(tool, op)
            status, txt, rev = H.simulate(sc, t2, a2, seen)
            op2, err = H.parse_operation(t2, a2)
            if op2:
                seen.add(H.op_identity(op2))
            calls.append(status)
            revealed.update(rev)

        fj = {"root_cause_summary": case["root"][0],
              "evidence_ids": sorted(revealed),
              "causal_explanation": "because of " + case["root"][0],
              "remediation_steps": [case["remediation"][0]],
              "risks": [], "missing_data": [], "confidence": 0.9}
        s2 = H.score_final(fj, sc, revealed)
        passed = H.scenario_passed(s2)

        rows.append({"case_id": case["id"], "target_tokens": case["target"],
                     "begin_found": markers["E1"]["found"], "mid_found": markers["E2"]["found"],
                     "end_found": markers["E3"]["found"], "begin_frac": markers["E1"]["frac"],
                     "mid_frac": markers["E2"]["frac"], "end_frac": markers["E3"]["frac"],
                     "root_correct": s2["root_correct"], "evidence_cov": s2["evidence_cov"],
                     "all_revealed": set(revealed) == {f[0] for f in case["facts"]},
                     "PASS": "PASS" if passed else "FAIL"})

    fields = list(rows[0].keys())
    with open(out, "w", newline="") as f:
        w = csv.DictWriter(f, fieldnames=fields); w.writeheader(); w.writerows(rows)

    n = len(rows); pas = sum(1 for r in rows if r["PASS"] == "PASS")
    print(f"LONG_CONTEXT_SCRIPTED_TOTAL={n}  PASS={pas}  FAIL={n-pas}")
    for r in rows:
        print(f"  {r['case_id']}: {r['PASS']} root={r['root_correct']} cov={r['evidence_cov']} "
              f"begin/mid/end={r['begin_found']}/{r['mid_found']}/{r['end_found']}")
    print(f"WROTE {out}")

if __name__ == "__main__":
    main()
