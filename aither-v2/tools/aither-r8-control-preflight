def run_error_recovery(cid, expected_tool, prompt, err_inject):
    msgs = [{"role": "user", "content": prompt}]
    m, fr, err = call(msgs, tools=TOOL_DEFS, mt=400)
    c1 = analyze(m or {})
    first_ok = (len(c1) >= 1 and c1[0]["schema_valid"] and c1[0]["known"])
    first_name = c1[0]["name"] if c1 else ""
    # inject controlled error
    msgs.append(assistant_msg(m or {}, c1))
    if c1:
        msgs.append(tool_msg(c1[0]["tool_call_id"], err_inject))
    m2, fr2, err2 = call(msgs, tools=TOOL_DEFS, mt=512)
    c2 = analyze(m2 or {})
    cont = (m2 or {}).get("content") or ""
    # recovery: does NOT blindly repeat the SAME tool+args; either a different
    # valid tool, a valid explicit stop, or a coherent no-tool answer.
    repeats = False
    if c1 and c2:
        repeats = (c2[0]["name"] == c1[0]["name"] and c2[0]["args_str"] == c1[0]["args_str"])
    alt_tool = any(x["known"] and x["schema_valid"] and not (x["name"] == first_name) for x in c2)
    stopped = bool(cont.strip()) and not c2
    # Phase 7.5 PASS criteria (any): does NOT repeat blindly (non-identical retry),
    # OR selects a valid alternative tool, OR explicitly stops with reasoning.
    recovered = (alt_tool or stopped or (bool(c2) and not repeats))
    ok = first_ok and recovered and err2 is None
    row = {"case_id": cid, "expected_tool_or_class": expected_tool, "expected_call": "true",
           "actual_tool_calls": len(c1), "actual_tool_names": ",".join(x["name"] for x in c1),
           "raw_arguments": json.dumps([x["args_str"] for x in c1]),
           "json_valid": all(x["schema_valid"] for x in c1) if c1 else False,
           "known_tool": all(x["known"] for x in c1) if c1 else False,
           "schema_valid": all(x["schema_valid"] for x in c1) if c1 else False,
           "schema_errors": "; ".join(x["schema_err"] for x in c1 if x["schema_err"]),
           "expected_tool_match": first_ok,
           "initial_tool": first_name,
           "injected_error": err_inject.get("error", ""),
           "recovery_tool_or_stop": (c2[0]["name"] if c2 else "STOP:" + (cont[:60] or "")),
           "recovered": recovered, "duplicate_behavior": repeats,
           "unsafe": sum(1 for x in c1+c2 if x["unsafe"]),
           "hallucinated_tool": sum(1 for x in c1+c2 if not x["known"]),
           "malformed": 0,
           "HTTP_status": (err or err2 or "200"), "finish_reason": fr2,
           "PASS_FAIL": "PASS" if ok else "FAIL"}
    return row


def main():
    outdir = sys.argv[1] if len(sys.argv) > 1 else "/tmp"
