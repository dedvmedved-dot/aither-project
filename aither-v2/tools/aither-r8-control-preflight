         "schema_valid": all(c["schema_valid"] for c in calls) if calls else False,
         "schema_errors": "; ".join(c["schema_err"] for c in calls if c["schema_err"]),
         "expected_tool_match": (len(calls) >= 1 and names[0] == "read_file"),
         "forced_specific_tool_choice": forced,
         "unsafe": sum(1 for c in calls if c["unsafe"]),
         "hallucinated_tool": sum(1 for c in calls if not c["known"]),
         "malformed": 0, "HTTP_status": err or "200", "finish_reason": fr,
         "PASS_FAIL": "PASS" if forced_supported else ("FAIL" if not forced_supported and err is None else "INFO")}
    rows.append(r); print(f"{r['case_id']}: {r['PASS_FAIL']} forced={forced} (tools={names})", flush=True)
    # 5) multi-tool (3)
    for cid, req, prompt in MULTI:
        r = run_multi(cid, req, prompt)
        rows.append(r); print(f"{r['case_id']}: {r['PASS_FAIL']} required={r['required_actions']} observed={r['observed_actions']}", flush=True)
    # 6) multi-turn (4)
    for cid, t, prompt in MT:
        r = run_multiturn(cid, t, prompt)
        rows.append(r); print(f"{r['case_id']}: {r['PASS_FAIL']} first={r['first_tool_correct']} cont={r['continuation_coherent']}", flush=True)
    # 7) error recovery (6)
    for i, (cid, t, prompt) in enumerate(ERR):
        r = run_error_recovery(cid, t, prompt, ERRORS[i])
        rows.append(r); print(f"{r['case_id']}: {r['PASS_FAIL']} initial={r['initial_tool']} inject={r['injected_error']} rec={r['recovered']}", flush=True)
    # 8) structured (4)
    for cid, t, prompt in STRUCT:
        r, _ = run_case(cid, prompt, t, ct={"enable_thinking": False})
        rows.append(r); print(f"{r['case_id']}: {r['PASS_FAIL']} (tools={r['actual_tool_names']})", flush=True)
    # 9) negative controls (4) - NOT counted
    neg_rows = []
    for cid, prompt in NEG:
        r, _ = run_case(cid, prompt, "-", neg=True, ct={"enable_thinking": False})
        neg_rows.append(r); print(f"{cid}: NEG (tools={r['actual_tool_calls']})", flush=True)

    # ---- summary ----
    expected_rows = [r for r in rows if r.get("PASS_FAIL") in ("PASS", "FAIL")]
    tool_cases = len(expected_rows)
    tool_pass = sum(1 for r in expected_rows if r["PASS_FAIL"] == "PASS")
    json_valid = sum(1 for r in expected_rows if r.get("json_valid"))
    schema_valid = sum(1 for r in expected_rows if r.get("schema_valid"))
    match = sum(1 for r in expected_rows if r.get("expected_tool_match"))
    hall = sum(r.get("hallucinated_tool", 0) for r in rows)
    unsafe = sum(r.get("unsafe", 0) for r in rows)
    malformed = sum(r.get("malformed", 0) for r in rows)
    http5xx = sum(1 for r in rows if str(r.get("HTTP_status", "200")).startswith("5"))
    multi = [r for r in expected_rows if r["case_id"].startswith("MULTI")]
    mt = [r for r in expected_rows if r["case_id"].startswith("MT_")]
    err_cases = [r for r in expected_rows if r["case_id"].startswith("ERR_")]
    neg_pass = sum(1 for r in neg_rows if r["actual_tool_calls"] == 0)

    print("\n===== PREFLIGHT SUMMARY =====")
    print(f"EXPECTED_TOOL_CASES={tool_cases}")
    print(f"EXPECTED_TOOL_CASE_PASS={tool_pass}/{tool_cases}")
    print(f"JSON_PARSE={json_valid}/{tool_cases}")
    print(f"ARG_SCHEMA_VALID={schema_valid}/{tool_cases}")
    print(f"EXPECTED_TOOL_MATCH={match}/{tool_cases}")
    print(f"HALLUCINATED_TOOL={hall} UNSAFE={unsafe} MALFORMED={malformed} HTTP5xx={http5xx}")
    print(f"MULTI_TOOL: {sum(1 for r in multi if r['PASS_FAIL']=='PASS')}/{len(multi)}")
    print(f"MULTI_TURN: {sum(1 for r in mt if r['PASS_FAIL']=='PASS')}/{len(mt)}")
    print(f"ERROR_RECOVERY: {sum(1 for r in err_cases if r['PASS_FAIL']=='PASS')}/{len(err_cases)}")
    print(f"NEGATIVE_CONTROLS_NO_TOOL: {neg_pass}/{len(neg_rows)}")

    # persist
    os.makedirs(outdir, exist_ok=True)
    csv_path = os.path.join(outdir, "AITHER_R8_CONTROL_QWEN38_PREFLIGHT.csv")
    jsonl_path = os.path.join(outdir, "AITHER_R8_CONTROL_QWEN38_PREFLIGHT_RAW.jsonl")
    all_rows = rows + neg_rows
    fields = []
    for r in all_rows:
        for k in r:
            if k not in fields:
                fields.append(k)
    with open(csv_path, "w", newline="") as f:
        w = csv.DictWriter(f, fieldnames=fields); w.writeheader(); w.writerows(all_rows)
    with open(jsonl_path, "w") as f:
        for rec in LEDGER:
            f.write(json.dumps(rec) + "\n")
    print(f"\nWROTE {csv_path}")
    print(f"WROTE {jsonl_path} ({len(LEDGER)} raw records)")
    print("DONE")


if __name__ == "__main__":
    main()
