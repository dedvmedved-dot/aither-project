LEDGER = []  # raw request/response records


def call(messages, tools=None, tool_choice=None, mt=400, chat_template=None):
    p = {"model": MODEL, "messages": messages, "max_tokens": mt,
         "temperature": 0.0, "top_p": 1.0}
    if chat_template:
        p["chat_template_kwargs"] = chat_template
    if tools:
        p["tools"] = tools
    if tool_choice is not None:
        p["tool_choice"] = tool_choice
    req_data = json.dumps(p).encode()
    hdrs = {"Content-Type": "application/json"}
    if KEY:
        hdrs["Authorization"] = "Bearer " + KEY
    req = urllib.request.Request(BASE + "/v1/chat/completions", data=req_data, headers=hdrs)
    t0 = time.time()
    status = 200
    resp_body = None
    try:
        resp_body = json.loads(urllib.request.urlopen(req, timeout=600).read().decode())
        lat = time.time() - t0
        c = resp_body["choices"][0]
        msg = c.get("message", {})
        fr = c.get("finish_reason")
        err = None
    except urllib.error.HTTPError as e:
        lat = time.time() - t0
        body = e.read().decode()[:800]
        resp_body = {"http_error": e.code, "body": body}
        status = e.code
        msg, fr, err = None, None, f"HTTP {e.code}"
    except Exception as e:
        lat = time.time() - t0
        resp_body = {"client_error": str(e)}
        status = -1
        msg, fr, err = None, None, str(e)
    LEDGER.append({"ts": time.time(), "request": json.loads(req_data.decode()),
                   "response": resp_body, "http_status": status,
                   "latency_s": round(lat, 3), "finish_reason": fr})
    return msg, fr, err


def validate_args(name, args_str):
    """TRUE JSON Schema validation of tool-call arguments."""
    try:
        args = json.loads(args_str)
    except Exception:
        return None, False, "JSON_PARSE_FAIL"
    if not isinstance(args, dict):
        return args, False, "NOT_OBJECT"
    if name not in TOOL_DEF_BY_NAME:
        return args, False, "UNKNOWN_TOOL"
    schema = TOOL_DEF_BY_NAME[name]["function"]["parameters"]
    try:
        jsonschema.validate(instance=args, schema=schema)
        return args, True, ""
    except jsonschema.ValidationError as e:
        return args, False, str(e.message)[:200]


def analyze(m):
    """Parse one assistant message into per-tool-call validity records."""
    tcs = m.get("tool_calls") or []
    out = []
    for tc in tcs:
        fn = tc.get("function", {})
        name = fn.get("name", "")
        args_str = fn.get("arguments", "") or ""
        args, schema_ok, schema_err = validate_args(name, args_str)
        known = name in KNOWN
        unsafe = bool(UNSAFE.search(args_str)) if isinstance(args_str, str) else False
        out.append({"name": name, "args": args, "args_str": args_str,
                    "schema_valid": schema_ok, "schema_err": schema_err,
                    "known": known, "unsafe": unsafe, "tool_call_id": tc.get("id", "0")})
    return out


def tool_msg(tc_id, content):
    return {"role": "tool", "tool_call_id": tc_id, "content": json.dumps(content)}


def assistant_msg(m, calls):
    return {"role": "assistant", "content": m.get("content"),
            "tool_calls": [{"id": c["tool_call_id"], "type": "function",
                            "function": {"name": c["name"], "arguments": c["args_str"]}}
                           for c in calls]}


