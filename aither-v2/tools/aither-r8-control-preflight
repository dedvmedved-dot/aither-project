def run_case(cid, prompt, expected, tool_choice=None, ct=None, neg=False):
    """Single expected-tool preflight case (or negative control)."""
    m, fr, err = call([{"role": "user", "content": prompt}],
                      tools=None if neg else TOOL_DEFS,
                      tool_choice=tool_choice, mt=400, chat_template=ct)
    calls = analyze(m or {})
    names = [c["name"] for c in calls]
    # exact expected-tool match
    if neg:
        match = (len(calls) == 0)
        verdict = "NEG"
    elif expected == "*":
        # tool-class case: any known tool, all valid
        ok = (len(calls) >= 1 and all(c["known"] and c["schema_valid"] for c in calls)
              and not any(c["unsafe"] for c in calls) and err is None)
        match = ok
        verdict = "PASS" if ok else "FAIL"
    else:
        ok = (len(calls) >= 1 and expected in names
              and all(c["known"] and c["schema_valid"] for c in calls)
              and not any(c["unsafe"] for c in calls) and err is None)
        match = ok
        verdict = "PASS" if ok else "FAIL"
    row = {"case_id": cid, "expected_tool_or_class": expected, "expected_call": "false" if neg else "true",
           "actual_tool_calls": len(calls), "actual_tool_names": ",".join(names),
           "raw_arguments": json.dumps([c["args_str"] for c in calls]),
           "json_valid": all(c["schema_valid"] for c in calls) if calls else (True if neg else False),
           "known_tool": all(c["known"] for c in calls) if calls else (True if neg else False),
           "schema_valid": all(c["schema_valid"] for c in calls) if calls else (True if neg else False),
           "schema_errors": "; ".join(c["schema_err"] for c in calls if c["schema_err"]),
           "expected_tool_match": match,
           "unsafe": sum(1 for c in calls if c["unsafe"]),
           "hallucinated_tool": sum(1 for c in calls if not c["known"]),
           "malformed": sum(1 for c in calls if c["schema_err"] == "JSON_PARSE_FAIL"),
           "HTTP_status": err or "200",
           "finish_reason": fr,
           "PASS_FAIL": verdict}
    return row, calls


def run_multi(cid, action_groups, prompt):
    m, fr, err = call([{"role": "user", "content": prompt}], tools=TOOL_DEFS, mt=512)
    calls = analyze(m or {})
    names = [c["name"] for c in calls]
    # Phase 7.3: "both required actions are issued; both use VALID tools" —
    # each required ACTION may be performed by any valid tool in its group.
    observed = []
    for grp in action_groups:
        hit = next((n for n in names if n in grp), None)
        observed.append(hit)
    ok = (all(h is not None for h in observed)
          and all(c["known"] and c["schema_valid"] for c in calls)
          and not any(c["unsafe"] for c in calls) and err is None)
    row = {"case_id": cid, "expected_tool_or_class": "+".join("|".join(g) for g in action_groups), "expected_call": "true",
           "actual_tool_calls": len(calls), "actual_tool_names": ",".join(names),
           "raw_arguments": json.dumps([c["args_str"] for c in calls]),
           "json_valid": all(c["schema_valid"] for c in calls) if calls else False,
           "known_tool": all(c["known"] for c in calls) if calls else False,
           "schema_valid": all(c["schema_valid"] for c in calls) if calls else False,
           "schema_errors": "; ".join(c["schema_err"] for c in calls if c["schema_err"]),
           "expected_tool_match": ok,
           "required_actions": json.dumps(["|".join(g) for g in action_groups]),
           "observed_actions": json.dumps([h or "" for h in observed]),
           "required_count": len(action_groups),
           "observed_required_count": sum(1 for h in observed if h),
           "unsafe": sum(1 for c in calls if c["unsafe"]),
           "hallucinated_tool": sum(1 for c in calls if not c["known"]),
           "malformed": sum(1 for c in calls if c["schema_err"] == "JSON_PARSE_FAIL"),
           "HTTP_status": err or "200", "finish_reason": fr,
           "PASS_FAIL": "PASS" if ok else "FAIL"}
    return row


# synthetic tool results for multi-turn / error recovery
def synth_result(name):
    if name == "systemctl_status":
        return {"revealed": True, "state": "active (running)", "service": "nginx"}
    if name == "kubectl_get":
        return {"revealed": True, "items": [{"name": "web-0"}, {"name": "web-1"}]}
    if name == "read_file":
        return {"revealed": True, "content": "localhost"}
    if name == "dns_lookup":
        return {"revealed": True, "addresses": ["10.0.0.5"]}
    return {"revealed": True, "ok": True}


def run_multiturn(cid, expected_tool, prompt):
    msgs = [{"role": "user", "content": prompt}]
    m, fr, err = call(msgs, tools=TOOL_DEFS, mt=400)
    c1 = analyze(m or {})
    first_ok = (len(c1) >= 1 and c1[0]["name"] == expected_tool
                and c1[0]["schema_valid"] and c1[0]["known"])
    # feed synthetic result back
    msgs.append(assistant_msg(m or {}, c1))
    if c1:
        msgs.append(tool_msg(c1[0]["tool_call_id"], synth_result(c1[0]["name"])))
    m2, fr2, err2 = call(msgs, tools=TOOL_DEFS, mt=512)
    c2 = analyze(m2 or {})
    cont = (m2 or {}).get("content") or ""
    # continuation valid if coherent final text OR a valid next tool call
    coherent = bool(cont.strip()) or (len(c2) >= 1 and all(c["known"] and c["schema_valid"] for c in c2))
    ok = (first_ok and coherent and err is None and err2 is None)
    row = {"case_id": cid, "expected_tool_or_class": expected_tool, "expected_call": "true",
           "actual_tool_calls": len(c1), "actual_tool_names": ",".join(x["name"] for x in c1),
           "raw_arguments": json.dumps([x["args_str"] for x in c1]),
           "json_valid": all(x["schema_valid"] for x in c1) if c1 else False,
           "known_tool": all(x["known"] for x in c1) if c1 else False,
           "schema_valid": all(x["schema_valid"] for x in c1) if c1 else False,
           "schema_errors": "; ".join(x["schema_err"] for x in c1 if x["schema_err"]),
           "expected_tool_match": first_ok,
           "first_tool_correct": first_ok,
           "result_accepted": bool(cont.strip() or c2),
           "continuation_coherent": coherent,
           "continuation_text": (cont or "")[:160],
           "unsafe": sum(1 for x in c1+c2 if x["unsafe"]),
           "hallucinated_tool": sum(1 for x in c1+c2 if not x["known"]),
           "malformed": 0,
           "HTTP_status": (err or err2 or "200"), "finish_reason": fr2,
           "PASS_FAIL": "PASS" if ok else "FAIL"}
    return row


