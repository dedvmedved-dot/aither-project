def main():
    corpus = []
    # positive root (50)
    for key, text in POSITIVE_ROOT:
        corpus.append({"id": f"POS-{len(corpus)+1:03d}", "category": "positive_root",
                       "text": text, "concept_keys": [key], "expected": True,
                       "note": f"paraphrase of {key}"})
    # negative rejected (50)
    for key, text in NEGATIVE_REJECTED:
        corpus.append({"id": f"NEG-{len(corpus)+1:03d}", "category": "negative_rejected",
                       "text": text, "concept_keys": [key], "expected": False,
                       "note": f"rejected text for {key}"})
    # remediation paraphrase (30)
    for key, text in REMEDIATION_PARAPHRASE:
        corpus.append({"id": f"REM-{len(corpus)+1:03d}", "category": "remediation",
                       "text": text, "concept_keys": [key], "expected": True,
                       "note": f"remediation paraphrase of {key}"})
    # ambiguous/partial (20)
    for key, text in AMBIGUOUS_PARTIAL:
        corpus.append({"id": f"AMB-{len(corpus)+1:03d}", "category": "ambiguous",
                       "text": text, "concept_keys": [key], "expected": False,
                       "note": f"ambiguous/partial for {key} (conservative no-match)"})
    # prohibited collisions (20)
    for text, prohibited, remed_class, exp in PROHIBITED_COLLISIONS:
        corpus.append({"id": f"PRO-{len(corpus)+1:03d}", "category": "prohibited_collision",
                       "text": text, "prohibited": prohibited, "remediation_class": remed_class,
                       "expected": exp, "note": "prohibited-action collision"})

    json.dump({"schema_version": "R7C1_V2_R3_R2", "entry_count": len(corpus), "entries": corpus},
              open(EVID + "AITHER_R8_R7C1_V2_MEASUREMENT_CLOSURE_FINAL_EVALUATOR_CORPUS.json", "w"),
              indent=2, ensure_ascii=False)

    # run tests
    rows = []
    for e in corpus:
        if e["category"] == "prohibited_collision":
            actual = H._contains_prohibited(e["text"], e["prohibited"], e["remediation_class"])
        else:
            actual = H.semantic_contains(e["text"], e["concept_keys"])
        ok = (actual == e["expected"])
        rows.append({"id": e["id"], "category": e["category"], "text": e["text"],
                     "expected": e["expected"], "actual": actual,
                     "PASS": "PASS" if ok else "FAIL"})

    with open(EVID + "AITHER_R8_R7C1_V2_MEASUREMENT_CLOSURE_FINAL_EVALUATOR_TESTS.csv", "w", newline="") as f:
        w = csv.DictWriter(f, fieldnames=["id", "category", "text", "expected", "actual", "PASS"])
        w.writeheader(); w.writerows(rows)

    n = len(rows); p = sum(1 for r in rows if r["PASS"] == "PASS")
    print(f"FINAL_EVALUATOR_TESTS={n} PASS={p} FAIL={n-p}")
    for r in rows:
        if r["PASS"] != "PASS":
            print("  FAIL:", r)
    print("ALL_PASS" if p == n else "SOME_FAILED")
    sys.exit(0 if p == n else 1)

if __name__ == "__main__":
    main()
