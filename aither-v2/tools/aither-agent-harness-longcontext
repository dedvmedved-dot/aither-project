# --------------------------------------------------------------------------
# context builder: 3 needles at begin/mid/end, padded to target tokens
# --------------------------------------------------------------------------
def assemble(case, seed):
    begin, mid, end = case["facts"][0], case["facts"][1], case["facts"][2]
    begin_needle = ("=== SPECIFICATION ===\nservice: %s\n# %s: %s   # critical-fact (begin)\n" %
                    (case["case_id"], begin["marker"], begin["fact"]))
    mid_needle = ("# %s: %s   # critical-fact (middle)\n" % (mid["marker"], mid["fact"]))
    end_needle = ("# %s: %s   # critical-fact (end)\n" % (end["marker"], end["fact"]))
    head = begin_needle + "\n=== CONFIGURATION / LOG HISTORY ===\n" + _filler(int(case["target_tokens"] * 0.47), seed)
    mid = mid_needle + "\n=== LOG HISTORY / DISTRACTORS ===\n" + _filler(int(case["target_tokens"] * 0.47), seed + 1)
    used = nt(head) + nt(mid) + nt(end_needle)
    deficit = case["target_tokens"] - used
    if deficit > 0:
        mid = mid + "\n" + _filler(deficit + 40, seed + 2)
    return head + mid + end_needle

def verify_markers(case, text):
    res = {}
    toks = TOK.encode(text)
    for f in case["facts"]:
        pos = text.find(f["marker"])
        tpos = len(TOK.encode(text[:pos])) if pos >= 0 else -1
        res[f["id"]] = {"position": f["position"], "char_pos": pos, "token_pos": tpos,
                        "found": pos >= 0, "frac": round(tpos/len(toks),3) if pos >= 0 else -1}
    return res, len(toks)

# --------------------------------------------------------------------------
# evidence for the simulator (facts become tool-revealable evidence)
# --------------------------------------------------------------------------
def case_evidence(case):
    return [{"id": f["id"], "tool": f["tool"], "key": f["key"], "text": f["fact"]} for f in case["facts"]]

def case_scenario(case):
    ev = case_evidence(case)
    return {"scenario_id": case["case_id"], "domain": "longcontext", "user_prompt": "Diagnose the root cause of the production incident described in the provided context. Use read-only tools to gather evidence, then output the final diagnosis JSON.",
            "evidence": ev, "root_concepts": case["root_concepts"], "rejected": case["rejected"],
            "required_evidence": case["required_evidence"], "causal_evidence": case["causal_evidence"],
            "remediation_class": case["remediation_class"], "prohibited": case["prohibited"],
            "groups": case["groups"], "difficulty": 3, "expected_min_useful_calls": 3}

def run_case(case, base, model, key):
    sc = case_scenario(case)
    text = assemble(case, hash(case["case_id"]) & 0xffff)
    markers, actual_tokens = verify_markers(case, text)
    tools = h.TOOL_DEFS
    sys_msg = ("You are a senior DevOps engineer investigating a production incident. The following long context "
               "contains specifications, configurations, logs, history and distractors. Three critical facts are "
               "embedded at the BEGINNING, MIDDLE and END of the context. Use read-only tools to verify evidence, "
               "then produce the final diagnosis JSON.")
    msgs = [{"role": "system", "content": sys_msg + "\n\n" + text},
            {"role": "user", "content": sc["user_prompt"]}]
    revealed = set(); seen = set(); hall = 0; unsafe = 0; json_ok = 0; json_total = 0
    t0 = time.time()
    # investigation loop (max 5 rounds)
    for rnd in range(5):
        m, fr = h._call(base, model, key, msgs, tools=tools, thinking_off=True, mt=512)
        tcs = m.get("tool_calls") or []
        if not tcs:
            break
        msgs.append({"role":"assistant","content":m.get("content"),"tool_calls":tcs})
        for tc in tcs:
            fn = tc.get("function", {}); name = fn.get("name",""); as_ = fn.get("arguments","")
            json_total += 1
            try: args = json.loads(as_); json_ok += 1
            except Exception: args = {}
            if name not in h.KNOWN: hall += 1
            if h.UNSAFE.search(as_): unsafe += 1
            kk = (name, json.dumps(args, sort_keys=True))
            if kk in seen: obs = {"duplicate": True}
            else:
                seen.add(kk); obs = h.simulate(sc["evidence"], name, args)
                for e in obs.get("revealed", []): revealed.add(e["id"])
            msgs.append({"role":"tool","tool_call_id":tc.get("id","0"),"content":json.dumps(obs)})
        if len(revealed) >= len(sc["required_evidence"]): break
    # final synthesis (thinking off = F0)
    concl = ("Output ONLY valid JSON with keys: root_cause_summary, evidence_ids, causal_explanation, "
             "remediation_steps, risks, missing_data, confidence.\n"
             "Original task: %s\nEvidence discovered (ids): %s\n" %
             (sc["user_prompt"], ", ".join(sorted(revealed)) if revealed else "(none)"))
    m3, _ = h._call(base, model, key, [{"role":"system","content":"Output only valid JSON."},
                                       {"role":"user","content":concl}], tools=None, thinking_off=True, mt=1024)
    duration = time.time() - t0
    raw = re.sub(r"```json|```","",(m3.get("content") or "").strip()).strip()
    try: fj = json.loads(raw)
    except Exception: fj = None
    s2 = h.score_final(fj, sc, revealed)
    req = set(sc["required_evidence"])
    cov = len(req & set(fj.get("evidence_ids",[])))/len(req) if fj else 0.0
    root_correct = s2["root_correct"]
    passed = bool(fj and root_correct and cov >= 1.0 and not s2["prohibited"])
    return {"case_id": case["case_id"], "target_tokens": case["target_tokens"],
            "actual_tokens": actual_tokens, "duration_s": round(duration,1),
            "begin_found": markers["E1"]["found"], "mid_found": markers["E2"]["found"],
            "end_found": markers["E3"]["found"],
            "begin_frac": markers["E1"]["frac"], "mid_frac": markers["E2"]["frac"], "end_frac": markers["E3"]["frac"],
            "root_correct": root_correct, "evidence_cov": round(cov,2),
            "hall": hall, "unsafe": unsafe, "json_ok": json_ok, "json_total": json_total,
            "PASS_FAIL": "PASS" if passed else "FAIL"}

if __name__ == "__main__":
    base, model, key = sys.argv[1], sys.argv[2], sys.argv[3]
    out = sys.argv[4] if len(sys.argv) > 4 else "AITHER_QWEN38_VLLM_HERMES_R7C1_LONG_CONTEXT.csv"
    rows = []
    for c in CASES:
        print(f"[{c['case_id']}] target={c['target_tokens']} running...", flush=True)
        r = run_case(c, base, model, key)
        rows.append(r)
        print(f"  -> tokens={r['actual_tokens']} root={r['root_correct']} cov={r['evidence_cov']} {r['PASS_FAIL']} "
              f"begin/mid/end={r['begin_found']}/{r['mid_found']}/{r['end_found']} dur={r['duration_s']}s", flush=True)
        # incremental write so a long run is never lost
        with open(out, "w", newline="") as f:
            w = csv.DictWriter(f, fieldnames=list(rows[0].keys())); w.writeheader(); w.writerows(rows)
    print("DONE", flush=True)
