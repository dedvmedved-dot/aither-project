# R1-3: no silent default namespace. Extract explicit namespace from prompt, else
# fall back to a documented normative map, else "default" only when truly unspecified.
_STATE_KEYWORDS = {"pending", "terminating", "containercreating", "imagepullbackoff",
                   "oomkilled", "crashloopbackoff", "running", "failed", "ready",
                   "notready", "completed", "unknown", "waiting", "succeeded"}
_NAMESPACE_MAP = {
    "K8S-01": "prod",  # "Pod web in prod is CrashLoopBackOff"
}

def extract_namespace(scenario_id, prompt):
    if scenario_id in _NAMESPACE_MAP:
        return _NAMESPACE_MAP[scenario_id]
    m = re.search(r'\bin\s+([a-z][a-z0-9-]{0,15})\b', prompt.lower())
    if m:
        tok = m.group(1)
        if tok not in _STATE_KEYWORDS:
            return tok
    return "default"

