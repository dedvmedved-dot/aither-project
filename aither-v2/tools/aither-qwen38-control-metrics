#!/usr/bin/env python3
"""Qwen3.8 control metrics computation — reads FULL/ROUTED summary CSVs + raw ledgers
and computes the frozen hard-gate metrics. Emits METRICS.json + METRICS.csv."""
import os, json, sys, csv

D = os.path.dirname(os.path.abspath(__file__))  # not used; absolute below
REPO = "/root/aither-project-r7-canonical"
EVID = REPO + "/docs/evidence/"
SCEN = json.load(open(EVID + "AITHER_R7C1_V2_R3_R1_SCENARIOS.json"))["scenarios"]
SCEN_BY = {s["scenario_id"]: s for s in SCEN}

def load_ledger(path):
    rows = []
    if not os.path.exists(path):
        return rows
    with open(path) as f:
        for line in f:
            line = line.strip()
            if line:
                rows.append(json.loads(line))
    return rows

def summarize(prefix):
    sum_rows = list(csv.DictReader(open(EVID + f"AITHER_R8_QWEN38_CONTROL_R7C1_V2_{prefix}_SUMMARY.csv")))
    ledger = load_ledger(EVID + f"AITHER_R8_QWEN38_CONTROL_R7C1_V2_{prefix}_RAW_LEDGER.jsonl")
    n = len(sum_rows)
    task_success = 100 * sum(1 for r in sum_rows if r["passed"] == "True") / n
    root = 100 * sum(1 for r in sum_rows if r["root_correct"] == "True") / n
    ev_disc = 100 * sum(float(r["evidence_cov"]) for r in sum_rows) / n
    schema = 100 * sum(1 for r in sum_rows if r["schema_valid"] == "True") / n
    causal = 100 * sum(1 for r in sum_rows if r["causal"] == "True") / n
    remed = 100 * sum(1 for r in sum_rows if r["remediation"] == "True") / n
    prohib = sum(1 for r in sum_rows if r["prohibited"] == "True")

    # tool metrics from ledger
    statuses = []
    for rec in ledger:
        for e in rec["result"]["ledger"]:
            if e.get("event") == "tool":
                statuses.append(e.get("sim_status"))
    total = len(statuses)
    reveal = sum(1 for s in statuses if s == "RELEVANT_REVEAL")
    dup = sum(1 for s in statuses if s == "DUPLICATE")
    irr = sum(1 for s in statuses if s == "IRRELEVANT")
    rel_neg = sum(1 for s in statuses if s == "RELEVANT_NEGATIVE")
    unsafe = sum(1 for s in statuses if s == "UNSAFE")
    malformed = sum(1 for s in statuses if s == "MALFORMED")
    unknown = sum(1 for s in statuses if s == "UNKNOWN_TOOL")
    schema_inv = sum(1 for s in statuses if s == "SCHEMA_INVALID")
    unsup = sum(1 for s in statuses if s == "UNSUPPORTED_SEMANTIC_OPERATION")
    nondup = total - dup
    precision = reveal / nondup if nondup else 0.0
    # recall = discovered required evidence / total required
    total_req = sum(len(set(s["required_evidence"])) for s in SCEN)
    disc_req = sum(len(set(SCEN_BY[rec["scenario_id"]]["required_evidence"]) & set(rec["result"]["revealed"]))
                   for rec in ledger)
    recall = disc_req / total_req if total_req else 0.0
    f1 = 2 * precision * recall / (precision + recall) if (precision + recall) else 0.0
    irr_rate = irr / nondup if nondup else 0.0
    dup_rate = dup / total if total else 0.0

    # hallucination / provenance
    fabricated = 0; unrevealed = 0
    for rec in ledger:
        s2 = rec["result"]["score"]
        fabricated += len(s2.get("fabricated_claimed_ids", []))
        unrevealed += len(s2.get("unrevealed_claimed_ids", []))
    return {"scenarios": n, "TASK_SUCCESS": round(task_success, 1), "ROOT_CAUSE": round(root, 1),
            "EVIDENCE_DISCOVERY": round(ev_disc, 1), "SCHEMA_VALID": round(schema, 1),
            "CAUSAL": round(causal, 1), "REMEDIATION": round(remed, 1), "PROHIBITED": prohib,
            "TOOL_PRECISION": round(100*precision, 1), "TOOL_RECALL": round(100*recall, 1),
            "TOOL_F1": round(100*f1, 1), "IRRELEVANT_CALL_RATE": round(100*irr_rate, 1),
            "DUPLICATE_CALL_RATE": round(100*dup_rate, 1), "RELEVANT_NEGATIVE": rel_neg,
            "UNSAFE": unsafe, "MALFORMED": malformed, "UNKNOWN_TOOL": unknown,
            "SCHEMA_INVALID": schema_inv, "UNSUPPORTED": unsup,
            "FABRICATED": fabricated, "UNREVEALED_CLAIMED": unrevealed}

def main():
    full = summarize("FULL")
    routed = summarize("ROUTED")
    out = {"FULL": full, "ROUTED": routed}
    json.dump(out, open(EVID + "AITHER_R8_QWEN38_CONTROL_R7C1_V2_METRICS.json", "w"), indent=2)
    with open(EVID + "AITHER_R8_QWEN38_CONTROL_R7C1_V2_METRICS.csv", "w", newline="") as f:
        w = csv.DictWriter(f, fieldnames=["profile"] + list(full.keys()))
        w.writeheader()
        w.writerow({"profile": "FULL", **{k: v for k, v in full.items()}})
        w.writerow({"profile": "ROUTED", **{k: v for k, v in routed.items()}})
    print(json.dumps(out, indent=2))

if __name__ == "__main__":
    main()
