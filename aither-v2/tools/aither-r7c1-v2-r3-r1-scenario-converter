#!/usr/bin/env python3
"""R7-C1 v2-R3 scenario converter — self-contained, deterministic, reproducible.

R3-1: uses ONLY the current R3 harness (no uncommitted/local code, no R1 dependency).
R3-2: explicit namespace migration map (no ambiguous regex; 'k8s' is a domain, not a ns).
R3-4: constrained relevance rules — specific scenario targets, no unjustified ANY.

Usage: python3 aither-r7c1-v2-r3-scenario-converter <v1_scenarios.json> <out_r3_scenarios.json>
"""
import json, sys, re, os
from importlib.machinery import SourceFileLoader

# R3-R1 portability: script-relative harness resolution (no hard-coded absolute path)
_SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
H = SourceFileLoader("r3r1", os.path.join(_SCRIPT_DIR, "aither-agent-harness-r7c1-v2-r3-r1")).load_module()

# ---------------------------------------------------------------------------
# R3-2: explicit namespace migration map. Only scenarios with an explicit
# namespace in the source prompt are mapped; everything else -> "default".
# No regex inference (which previously misread "k8s" as a namespace in X-04).
# ---------------------------------------------------------------------------
NAMESPACE_MAP = {
    "K8S-01": "prod",     # "Pod web in prod is CrashLoopBackOff"
    "X-04": "default",    # "DNS resolution fails in k8s pod" -> k8s = Kubernetes domain, NOT namespace
}

def extract_namespace(scenario_id):
    return NAMESPACE_MAP.get(scenario_id, "default")

