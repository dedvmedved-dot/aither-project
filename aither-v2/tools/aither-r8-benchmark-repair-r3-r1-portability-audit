#!/usr/bin/env python3
"""R7-C1 v2 portability audit — script-relative repo resolution, AST-based scan,
no whole-file exclusions. Audits ALL R3-R1 runtime tools including this audit and
the checker.

Produces:
  AITHER_R7C1_V2_PORTABILITY_AUDIT_SELF_CLOSURE_RUNTIME_TOOL_AUDIT.csv
  AITHER_R7C1_V2_PORTABILITY_AUDIT_SELF_CLOSURE_CWD_TESTS.csv
  AITHER_R7C1_V2_PORTABILITY_AUDIT_SELF_CLOSURE_SEMANTIC_IMMUTABILITY.json
"""
import os, sys, csv, json, subprocess, glob, hashlib
from importlib.machinery import SourceFileLoader

_SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
REPO = os.path.abspath(os.path.join(_SCRIPT_DIR, "..", ".."))
TOOLS = os.path.join(REPO, "aither-v2", "tools")
EVID = os.path.join(REPO, "docs", "evidence")

# reuse the AST-based detector from the checker (script-relative import)
_checker = SourceFileLoader("portcheck", os.path.join(_SCRIPT_DIR, "aither-r8-benchmark-repair-r3-r1-portability-check")).load_module()
find_forbidden_runtime_deps = _checker.find_forbidden_runtime_deps

V1 = EVID + "/AITHER_QWEN38_VLLM_HERMES_R7_SCENARIOS.json"
SCEN = EVID + "/AITHER_R7C1_V2_R3_R1_SCENARIOS.json"

def sha256(p):
    h = hashlib.sha256()
    with open(p, "rb") as f:
        for c in iter(lambda: f.read(65536), b""): h.update(c)
    return h.hexdigest()

def runtime_tools():
    files = sorted(glob.glob(TOOLS + "/aither-*r3-r1*"))
    files.append(TOOLS + "/aither-r7c1-v2-r3-r1-scenario-converter")
    files.append(TOOLS + "/aither-agent-harness-r7c1-v2-r3-r1")
    return [f for f in files if not f.endswith(".pyc")]

def main():
    no_cwd = "--no-cwd" in sys.argv
    # ---- Runtime tool audit (all tools, incl. audit + checker) ----
    audit_rows = []
    for f in runtime_tools():
        src = open(f).read()
        deps = find_forbidden_runtime_deps(f)
        imports_harness = "aither-agent-harness" in src and "SourceFileLoader" in src
        has_script_dir = "_SCRIPT_DIR" in src
        if imports_harness and has_script_dir and not deps:
            mode = "script-relative"
        elif imports_harness and deps:
            mode = "ABSOLUTE"
        else:
            mode = "n/a"
        cwd_dep = "NO" if (mode != "ABSOLUTE") else "YES"
        audit_rows.append({"file": os.path.basename(f), "imports_harness": "YES" if imports_harness else "NO",
                           "path_resolution_mode": mode, "forbidden_runtime_dep": "YES" if deps else "NO",
                           "cwd_dependency": cwd_dep,
                           "PASS_FAIL": "PASS" if not deps else "FAIL"})
    with open(EVID + "/AITHER_R7C1_V2_PORTABILITY_AUDIT_SELF_CLOSURE_RUNTIME_TOOL_AUDIT.csv", "w", newline="") as f:
        w = csv.DictWriter(f, fieldnames=list(audit_rows[0].keys())); w.writeheader(); w.writerows(audit_rows)

    # ---- Portability tooling CWD test (run from /tmp, no REPO env) ----
    # Only when not --no-cwd (avoids self-recursion: the CWD test spawns the audit
    # with --no-cwd so it does not re-run this test).
    if not no_cwd:
        cwd_rows = []
        tmp_out = "/tmp/r3r1_selfclosure"
        os.makedirs(tmp_out, exist_ok=True)
        runs = [
            ("portability-audit", ["python3", TOOLS+"/aither-r8-benchmark-repair-r3-r1-portability-audit", "--no-cwd"], 0),
            ("portability-check", ["python3", TOOLS+"/aither-r8-benchmark-repair-r3-r1-portability-check", tmp_out+"/scan.txt"], 0),
        ]
        for name, cmd, expected in runs:
            r = subprocess.run(cmd, cwd="/tmp", capture_output=True, text=True)
            ok = (r.returncode == expected)
            cwd_rows.append({"tool": name, "cwd": "/tmp", "exit_code": r.returncode,
                             "expected_exit_code": expected, "PASS_FAIL": "PASS" if ok else "FAIL"})
            if not ok:
                print(f"CWD FAIL {name}: exit={r.returncode} err={r.stderr[:300]}")
        with open(EVID + "/AITHER_R7C1_V2_PORTABILITY_AUDIT_SELF_CLOSURE_CWD_TESTS.csv", "w", newline="") as f:
            w = csv.DictWriter(f, fieldnames=list(cwd_rows[0].keys())); w.writeheader(); w.writerows(cwd_rows)

    # ---- Semantic immutability ----
    base = "290ecee374b21926bc2188522cc5afe66d263235"
    sem = {}
    for name, path in [("scenarios", "docs/evidence/AITHER_R7C1_V2_R3_R1_SCENARIOS.json"),
                       ("harness", "aither-v2/tools/aither-agent-harness-r7c1-v2-r3-r1")]:
        cur = sha256(REPO + "/" + path)
        base_blob = subprocess.run(["git", "-C", REPO, "show", f"{base}:{path}"], capture_output=True).stdout
        base_sha = hashlib.sha256(base_blob).hexdigest()
        sem[name] = {"baseline_sha256": base_sha, "final_sha256": cur, "unchanged": base_sha == cur}
    sem["scenario_semantics_unchanged"] = "YES" if sem["scenarios"]["unchanged"] else "NO"
    sem["harness_unchanged"] = "YES" if sem["harness"]["unchanged"] else "NO"
    sem["matcher_semantics_unchanged"] = "YES" if sem["harness"]["unchanged"] else "NO"
    sem["evaluator_semantics_unchanged"] = "YES" if sem["harness"]["unchanged"] else "NO"
    sem["relevance_semantics_unchanged"] = "YES" if sem["scenarios"]["unchanged"] else "NO"
    sem["con03_semantics_unchanged"] = "YES" if sem["scenarios"]["unchanged"] else "NO"
    json.dump(sem, open(EVID + "/AITHER_R7C1_V2_PORTABILITY_AUDIT_SELF_CLOSURE_SEMANTIC_IMMUTABILITY.json", "w"), indent=2)

    n = len(audit_rows); p = sum(1 for r in audit_rows if r["PASS_FAIL"] == "PASS")
    print(f"RUNTIME_TOOL_AUDIT={p}/{n}")
    if not no_cwd:
        cn = len(cwd_rows); cp = sum(1 for r in cwd_rows if r["PASS_FAIL"] == "PASS")
        print(f"PORTABILITY_TOOLING_CWD={cp}/{cn}")
    print("SEMANTIC_IMMUTABILITY:", json.dumps({k: sem[k] for k in ("scenario_semantics_unchanged","harness_unchanged","con03_semantics_unchanged")}))

if __name__ == "__main__":
    main()
