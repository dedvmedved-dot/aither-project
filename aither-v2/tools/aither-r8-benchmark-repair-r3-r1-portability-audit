#!/usr/bin/env python3
"""R7-C1 v2-R3-R1 portability audit + CWD-independence test + semantic immutability.

Produces:
  PORTABILITY_AUDIT.csv
  PORTABILITY_CWD_INDEPENDENCE_TESTS.csv
  PORTABILITY_SEMANTIC_IMMUTABILITY.json
"""
import os, sys, csv, json, subprocess, glob, hashlib

REPO = os.environ.get("REPO", "/root/aither-project-r7-canonical")
TOOLS = REPO + "/aither-v2/tools"
EVID = REPO + "/docs/evidence"
V1 = EVID + "/AITHER_QWEN38_VLLM_HERMES_R7_SCENARIOS.json"
SCEN = EVID + "/AITHER_R7C1_V2_R3_R1_SCENARIOS.json"
FORBIDDEN = ["/root/aither-project-r7-canonical", "/root/"]

def sha256(p):
    h = hashlib.sha256()
    with open(p, "rb") as f:
        for c in iter(lambda: f.read(65536), b""): h.update(c)
    return h.hexdigest()

def main():
    # ---- Portability audit ----
    audit_rows = []
    files = sorted(glob.glob(TOOLS + "/aither-*r3-r1*"))
    files += [TOOLS + "/aither-r7c1-v2-r3-r1-scenario-converter"]
    # exclude audit tooling (checker/audit) which DEFINE the forbidden list, and .pyc
    files = [f for f in files if not f.endswith(".pyc") and "portability" not in os.path.basename(f)]
    for f in files:
        src = open(f).read()
        imports_harness = "SourceFileLoader" in src and "aither-agent-harness-r7c1-v2-r3-r1" in src
        abs_path = any(p in src for p in FORBIDDEN)
        has_script_dir = "_SCRIPT_DIR" in src
        rel_resolution = "script-relative" if (imports_harness and has_script_dir) else ("n/a" if not imports_harness else "ABSOLUTE")
        cwd_dep = "NO" if (not imports_harness or has_script_dir) else "YES"
        audit_rows.append({"file": os.path.basename(f), "imports_harness": "YES" if imports_harness else "NO",
                           "path_resolution_mode": rel_resolution, "absolute_path_present": "YES" if abs_path else "NO",
                           "cwd_dependency": cwd_dep, "PASS_FAIL": "PASS" if (not abs_path and cwd_dep == "NO") else "FAIL"})
    with open(EVID + "/AITHER_R8_BENCHMARK_REPAIR_R7C1_V2_R3_R1_PORTABILITY_AUDIT.csv", "w", newline="") as f:
        w = csv.DictWriter(f, fieldnames=list(audit_rows[0].keys())); w.writeheader(); w.writerows(audit_rows)

    # ---- CWD-independence test (run from /tmp) ----
    cwd_rows = []
    tmp_out = "/tmp/r3r1_cwd_out"
    os.makedirs(tmp_out, exist_ok=True)
    runners = [
        ("scenario-converter", ["python3", TOOLS+"/aither-r7c1-v2-r3-r1-scenario-converter", V1, tmp_out+"/scen.json"], 0),
        ("con03", ["python3", TOOLS+"/aither-r8-benchmark-repair-r3-r1-con03", SCEN, tmp_out+"/con03.csv"], 0),
        ("tests", ["python3", TOOLS+"/aither-r8-benchmark-repair-r3-r1-tests", V1, SCEN, tmp_out], 0),
        ("opdim", ["python3", TOOLS+"/aither-r8-benchmark-repair-r3-r1-opdim", SCEN, tmp_out], 0),
        ("scripted", ["python3", TOOLS+"/aither-r8-benchmark-repair-r3-r1-scripted", SCEN, "positive", tmp_out+"/pos.csv"], 0),
        ("evaltests", ["python3", TOOLS+"/aither-r8-benchmark-repair-r3-r1-evaltests", SCEN, tmp_out+"/eval.csv"], 0),
        ("longcontext", ["python3", TOOLS+"/aither-r8-benchmark-repair-r3-r1-longcontext", tmp_out+"/lc.csv"], 0),
        ("preflight", ["python3", TOOLS+"/aither-r8-benchmark-repair-r3-r1-preflight", tmp_out+"/pf.csv"], 0),
    ]
    for name, cmd, expected in runners:
        r = subprocess.run(cmd, cwd="/tmp", capture_output=True, text=True)
        ok = (r.returncode == expected)
        # check artifact created
        artifact = cmd[-1] if name != "opdim" and name != "tests" else (tmp_out + "/AITHER_R8_BENCHMARK_REPAIR_R7C1_V2_R3_R1_OPERATION_DIMENSION_EXECUTABLE_TESTS.csv")
        if name == "tests":
            artifact = tmp_out + "/AITHER_R8_BENCHMARK_REPAIR_R7C1_V2_R3_R1_SOURCE_SEMANTIC_ASSERTS.csv"
        created = os.path.exists(artifact)
        cwd_rows.append({"runner": name, "cwd": "/tmp", "exit_code": r.returncode,
                         "expected_exit_code": expected, "output_artifact_created": created,
                         "PASS_FAIL": "PASS" if (ok and created) else "FAIL"})
        if not (ok and created):
            print(f"CWD FAIL {name}: exit={r.returncode} err={r.stderr[:200]}")
    with open(EVID + "/AITHER_R8_BENCHMARK_REPAIR_R7C1_V2_R3_R1_PORTABILITY_CWD_INDEPENDENCE_TESTS.csv", "w", newline="") as f:
        w = csv.DictWriter(f, fieldnames=list(cwd_rows[0].keys())); w.writeheader(); w.writerows(cwd_rows)

    # ---- Semantic immutability ----
    # scenario JSON + harness must be byte-identical to baseline f5e8324
    base = "f5e8324391edab33326e607f155e5af4d1ee0a68"
    sem = {}
    for name, path in [("scenarios", "docs/evidence/AITHER_R7C1_V2_R3_R1_SCENARIOS.json"),
                       ("harness", "aither-v2/tools/aither-agent-harness-r7c1-v2-r3-r1")]:
        cur = sha256(REPO + "/" + path)
        base_blob = subprocess.run(["git", "-C", REPO, "show", f"{base}:{path}"], capture_output=True).stdout
        base_sha = hashlib.sha256(base_blob).hexdigest()
        sem[name] = {"baseline_sha256": base_sha, "final_sha256": cur, "unchanged": base_sha == cur}
    sem["scenario_semantics_unchanged"] = "YES" if sem["scenarios"]["unchanged"] else "NO"
    sem["matcher_semantics_unchanged"] = "YES" if sem["harness"]["unchanged"] else "NO"
    sem["evaluator_semantics_unchanged"] = "YES" if sem["harness"]["unchanged"] else "NO"
    sem["relevance_semantics_unchanged"] = "YES" if sem["scenarios"]["unchanged"] else "NO"
    sem["con03_semantics_unchanged"] = "YES" if sem["scenarios"]["unchanged"] else "NO"
    sem["diff_classification"] = "PORTABILITY_ONLY"
    json.dump(sem, open(EVID + "/AITHER_R8_BENCHMARK_REPAIR_R7C1_V2_R3_R1_PORTABILITY_SEMANTIC_IMMUTABILITY.json", "w"), indent=2)

    n = len(audit_rows); p = sum(1 for r in audit_rows if r["PASS_FAIL"] == "PASS")
    print(f"PORTABILITY_AUDIT={p}/{n}")
    cn = len(cwd_rows); cp = sum(1 for r in cwd_rows if r["PASS_FAIL"] == "PASS")
    print(f"CWD_INDEPENDENCE={cp}/{cn}")
    print("SEMANTIC_IMMUTABILITY:", json.dumps({k: sem[k] for k in ("scenario_semantics_unchanged","matcher_semantics_unchanged","con03_semantics_unchanged")}))

if __name__ == "__main__":
    main()
