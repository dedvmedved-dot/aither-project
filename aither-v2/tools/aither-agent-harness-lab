# ---- planner P0 (rule-based) ----
DOMAIN_GROUPS = {
 "linux":["LINUX","FILES"],"network":["NETWORK","LINUX"],"k8s":["KUBERNETES"],
 "container":["KUBERNETES","LINUX"],"storage":["LINUX","KUBERNETES"],"kvm":["LINUX"],
 "git":["GIT"],"cicd":["LINUX","GIT","FILES"],"code":["FILES","LINUX"],
 "security":["LINUX","KUBERNETES","NETWORK","FILES"],"cross":["KUBERNETES","NETWORK","LINUX"],
}
def route_p0(scenario):
    return scenario["groups"]

# ---- HTTP ----
def _post(p, timeout=900):
    url = BASE + "/v1/chat/completions"
    h = {"Content-Type":"application/json"}
    if KEY: h["Authorization"]="Bearer "+KEY
    r = urllib.request.Request(url, data=json.dumps(p).encode(), headers=h)
    return urllib.request.urlopen(r, timeout=timeout)

def _call(messages, tools=None, thinking_off=True, mt=512):
    p = {"model":MODEL,"messages":messages,"max_tokens":mt,"temperature":0.0,"top_p":1.0}
    if thinking_off: p["chat_template_kwargs"]={"enable_thinking":False}
    if tools: p["tools"]=tools
    try:
        b = json.loads(_post(p).read().decode())
        return b.get("choices",[{}])[0].get("message",{}), b.get("choices",[{}])[0].get("finish_reason")
    except urllib.error.HTTPError as e:
        return {"error": f"HTTP {e.code}"}, ""

# ---- scoring ----
def score(final, key):
    f = (final or "").lower()
    root = any(s.lower() in f for s in key["root_cause"])
    causal = key["causal"].lower() in f or any(w in f for w in key["causal"].lower().split()[:3])
    ev = [e.lower() for e in key["required_evidence"]]
    cov = sum(1 for e in ev if e in f) / max(len(ev),1)
    prohib = any(p.lower() in f for p in key["prohibited"])
    remed = any(r.lower() in f for r in key["remediation"]) or ("remediation" in f and len(f)>100)
    return {"root_cause_correct": root, "causal_correct": causal,
            "evidence_coverage": round(cov,2), "prohibited_hit": prohib,
            "remediation_safe": remed}

def run_scenario(sc, routed):
    # select tool catalog
    if routed:
        groups = sc["groups"]
        tools = [t for g in groups for t in GROUPS[g]]
    else:
        tools = ALL_TOOLS
    msgs = [{"role":"system","content":"You are a careful DevOps responder. Investigate using only the provided read-only tools. Do not repeat calls. Once you have evidence, produce a final diagnosis."},
            {"role":"user","content": sc["prompt"]}]
    ledger=[]; seen=set(); unsafe=0; hall=0; json_ok=0; json_total=0; dup=0; noninf=0
    final=""; newinfo_streak=0
    for rnd in range(12):
        m, fr = _call(msgs, tools=tools, thinking_off=True, mt=512)
        tcs = m.get("tool_calls") or []
        if not tcs:
            final = (m.get("content") or "").strip(); break
        msgs.append({"role":"assistant","content":m.get("content"),"tool_calls":tcs})
        for tc in tcs:
            fn=tc.get("function",{}); name=fn.get("name",""); args_s=fn.get("arguments","")
            json_total+=1
            try: args=json.loads(args_s); json_ok+=1
            except Exception: args={}
            if name not in KNOWN: hall+=1
            if UNSAFE.search(args_s): unsafe+=1
            key=(name, json.dumps(args, sort_keys=True))
            if key in seen: dup+=1; obs={"duplicate":True}; newinfo=False
            else:
                seen.add(key); obs=simulate(sc["facts"], name, args)
                newinfo = not (isinstance(obs,dict) and "error" in obs)
                if not newinfo: noninf+=1
            ledger.append({"tool":name,"args":args,"result":obs,"new_information":newinfo})
            msgs.append({"role":"tool","tool_call_id":tc.get("id","0"),"content":json.dumps(obs)})
            if not newinfo: newinfo_streak+=1
            else: newinfo_streak=0
        # loop control: replan / stop
        if newinfo_streak >= 3:
            break
    if not final:
        ledger_txt="\n".join(f"- {e['tool']}({json.dumps(e.get('args'),sort_keys=True)}) -> {str(e['result'])[:150]}" for e in ledger)
        concl=("Produce a final DevOps diagnosis in EXACTLY this format:\nDIAGNOSIS: <root cause>\n"
               "EVIDENCE: <facts with tool provenance>\nCAUSAL LINK: <why>\nREMEDIATION: <safe steps>\n"
               "MISSING_DATA: <what is unknown>\n\n"
               f"Original task: {sc['prompt']}\n\nEvidence:\n{ledger_txt}")
        thinking_off = (FINAL_THINKING == "off")
        m2, _ = _call([{"role":"system","content":"You produce final DevOps diagnoses."},
                       {"role":"user","content":concl}], tools=None, thinking_off=thinking_off, mt=2048)
        final = (m2.get("content") or "").strip()
    sc_s = score(final, sc["key"])
    # tool precision/recall
    relevant_groups = set(sc["groups"])
    relevant_names = {t["function"]["name"] for g in relevant_groups for t in GROUPS[g]}
    calls = [e for e in ledger if e.get("new_information") is not False or "error" not in str(e["result"])]
    nondup = [e for e in ledger if not isinstance(e["result"], dict) or not e["result"].get("duplicate")]
    relevant = [e for e in nondup if e["tool"] in relevant_names]
    irrelevant = [e for e in nondup if e["tool"] not in relevant_names]
    precision = len(relevant)/len(nondup) if nondup else 0
    expected_sources = [e.lower() for e in sc["key"]["required_evidence"]]
    recall = sum(1 for e in expected_sources if any(e[:6] in json.dumps(x["result"]).lower() for x in ledger))/max(len(expected_sources),1)
    f1 = 2*precision*recall/(precision+recall) if (precision+recall)>0 else 0
    passed = sc_s["root_cause_correct"] and sc_s["causal_correct"] and sc_s["evidence_coverage"]>=0.8 and sc_s["remediation_safe"] and not sc_s["prohibited_hit"]
    return {"id":sc["id"],"passed":passed,"final_nonempty":bool(final),
            "root_cause":sc_s["root_cause_correct"],"causal":sc_s["causal_correct"],
            "evidence":sc_s["evidence_coverage"],"remediation":sc_s["remediation_safe"],
            "prohibited":sc_s["prohibited_hit"],"precision":round(precision,2),"recall":round(recall,2),
            "f1":round(f1,2),"irrelevant":len(irrelevant),"dup":dup,"noninf":noninf,
            "json_ok":json_ok,"json_total":json_total,"unsafe":unsafe,"hall":hall,
            "final":final[:180]}

def main():
    results = [run_scenario(sc, MODE=="routed") for sc in S]
    n=len(results)
    succ=sum(1 for r in results if r["passed"])
    nonempty=sum(1 for r in results if r["final_nonempty"])
    jt=sum(r["json_total"] for r in results); jo=sum(r["json_ok"] for r in results)
    unsafe=sum(r["unsafe"] for r in results); hall=sum(r["hall"] for r in results)
    dup=sum(r["dup"] for r in results); noninf=sum(r["noninf"] for r in results)
    irr=sum(r["irrelevant"] for r in results)
    prec=sum(r["precision"] for r in results)/n
    rec=sum(r["recall"] for r in results)/n
    f1=sum(r["f1"] for r in results)/n
    print(f"=== ORCHESTRATION ({MODE}, final_thinking={FINAL_THINKING}): {n} scenarios ===")
    print(f"TASK_SUCCESS: {100*succ/n:.1f}%")
    print(f"ROOT_CAUSE_CORRECT: {100*sum(1 for r in results if r['root_cause'])/n:.1f}%")
    print(f"FINAL_NONEMPTY: {100*nonempty/n:.1f}%")
    print(f"TOOL_PRECISION: {100*prec:.1f}%  TOOL_RECALL: {100*rec:.1f}%  TOOL_F1: {100*f1:.1f}%")
    print(f"JSON_VALIDITY: {100*jo/max(jt,1):.1f}%  UNSAFE:{unsafe} HALL:{hall} DUP:{dup} NONINF:{noninf} IRRELEVANT:{irr}")
    if OUT_CSV:
        with open(OUT_CSV,"w",newline="") as f:
            w=csv.DictWriter(f, fieldnames=["id","passed","final_nonempty","root_cause","causal","evidence","remediation","prohibited","precision","recall","f1","irrelevant","dup","noninf","json_ok","json_total","unsafe","hall","final"])
            w.writeheader()
            for r in results: w.writerow({k:r.get(k,"") for k in w.fieldnames})
    for r in results: print(json.dumps(r, ensure_ascii=False), flush=True)

if __name__ == "__main__":
    main()
