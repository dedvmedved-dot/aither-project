def long_scenario(seed):
    return {"id":"LH-"+seed,
        "prompt":"You are a DevOps incident responder. The 'web' service in 'prod' is degraded. Investigate and produce a remediation plan.",
        "fixtures":{"kubectl_get":{"{\"resource\": \"pods\", \"namespace\": \"prod\"}":"web-7d9c8f 0/1 CrashLoopBackOff"},
            "kubectl_describe":{"{\"pod\": \"web-7d9c8f\", \"namespace\": \"prod\"}":"Liveness HTTP 500; Exit 1"},
            "kubectl_logs":{"{\"pod\": \"web-7d9c8f\", \"namespace\": \"prod\"}":"ERROR db connect refused 10.0.0.10:5432"}},
        "diagnosis":["database","5432","crash","refused","postgres"],
        "tools":["kubectl_get","kubectl_describe","kubectl_logs"]}

def main():
    results = [run_scenario(s) for s in S] + [run_scenario(long_scenario(str(i))) for i in range(12)]
    n = len(results)
    succ = sum(1 for r in results if r["success"])
    nonempty = sum(1 for r in results if r["final_nonempty"])
    json_t = sum(r["json_total"] for r in results); json_o = sum(r["json_ok"] for r in results)
    unsafe = sum(r["unsafe"] for r in results); hall = sum(r["hallucinated"] for r in results)
    dup = sum(r["duplicate"] for r in results); noninf = sum(r["noninformative"] for r in results)
    print(f"=== HARNESS SUITE: {n} scenarios ===")
    print(f"TASK_SUCCESS_RATE: {100*succ/n:.1f}%")
    print(f"FINAL_NONEMPTY_RATE: {100*nonempty/n:.1f}%")
    print(f"TOOL_SELECTION_ACCURACY: {100*sum(1 for r in results if r['tool_ok'])/n:.1f}%")
    print(f"JSON_VALIDITY: {100*json_o/max(json_t,1):.1f}%")
    print(f"UNSAFE: {unsafe}  HALLUCINATED: {hall}  DUPLICATE: {dup}  NONINFORMATIVE: {noninf}")
    if len(sys.argv) > 4:
        with open(sys.argv[4], "w", newline="") as f:
            w = csv.DictWriter(f, fieldnames=["id","success","diag_ok","tool_ok","final_nonempty",
                "unsafe","hallucinated","duplicate","noninformative","json_ok","json_total","final"])
            w.writeheader()
            for r in results:
                w.writerow({k: r.get(k,"") for k in w.fieldnames})
    for r in results:
        print(json.dumps(r, ensure_ascii=False), flush=True)

if __name__ == "__main__":
    main()
