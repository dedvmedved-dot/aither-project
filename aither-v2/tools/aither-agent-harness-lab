#!/usr/bin/env python3
"""Aither agent ORCHESTRATION harness (R6) — semantic simulator + routed tools + causal scoring.

Key differences from R5:
- semantic simulator (normalized fact lookup, no brittle exact-arg fixtures);
- >=50 UNIQUE scenarios with structured causal answer keys;
- tool groups + P0 rule-based router (MODE B) vs full catalog (MODE A);
- loop control: replan after 2 consecutive non-informative, stop tool phase after 3;
- final synthesis: stateless, no tools, thinking OFF (F0) vs ON (F1);
- causal scoring: root cause + causal link + evidence coverage + safe remediation.

Usage: aither-agent-harness-lab <base> <model> <key> <mode> [out_csv] [final_thinking]
  mode: full | routed
  final_thinking: off | on
"""
import json, sys, re, csv, urllib.request, urllib.error, time

BASE = sys.argv[1]; MODEL = sys.argv[2]; KEY = sys.argv[3] if len(sys.argv) > 3 else ""
MODE = sys.argv[4] if len(sys.argv) > 4 else "routed"
OUT_CSV = sys.argv[5] if len(sys.argv) > 5 else ""
FINAL_THINKING = sys.argv[6] if len(sys.argv) > 6 else "off"

