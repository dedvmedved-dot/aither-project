# ---- semantic arg normalization (equivalence classes) ----
def norm_pod(p):
    p = (p or "").lower().strip()
    return re.sub(r"-[a-z0-9]{8,10}-[a-z0-9]{5}$", "", p)

def arg_key(tool, args):
    if tool in ("systemctl_status","journalctl_read"): return args.get("service","").lower()
    if tool == "shell_readonly": return args.get("command","").strip()
    if tool in ("kubectl_logs","kubectl_describe"): return norm_pod(args.get("pod",""))
    if tool == "kubectl_get":
        r = args.get("resource","").lower().rstrip("s")
        return ("pods" if r in ("pod","pods") else r)  # pod/pods equivalence
    if tool in ("git_status","git_diff"): return args.get("repo","").lower()
    if tool == "git_show": return f"{args.get('repo','').lower()}|{args.get('commit','').lower()}"
    if tool == "read_file": return args.get("path","").lstrip("/")
    if tool == "list_directory": return args.get("path","").lstrip("/")
    if tool == "grep_search": return args.get("pattern","").lower()
    if tool == "http_get": return args.get("url","").rstrip("/")
    if tool == "dns_lookup": return args.get("hostname","").lower().rstrip(".")
    return json.dumps(args, sort_keys=True)

def simulate(evidence, tool, args):
    """Return (list_of_revealed_evidence_objs) or realistic empty/permission/timeout."""
    k = arg_key(tool, args)
    out = []
    for e in evidence:
        if e["tool"] == tool and e["key"] == k:
            out.append(e)
    if out: return {"revealed": out}
    # realistic fallback
    if tool in ("kubectl_logs","kubectl_describe","read_file"):
        return {"not_found": True}
    if tool in ("shell_readonly",):
        return {"unsupported": True}
    return {"empty": True}

# ---- scenario corpus (50 unique, evidence IDs + answer keys) ----
def E(i, tool, key, text): return {"id": i, "tool": tool, "key": key, "text": text}

SCENARIOS = []
def A(scid, domain, prompt, evidence, root_concepts, rejected, required, causal, remed_class, prohib, groups, diff=1, min_calls=2):
    SCENARIOS.append({"scenario_id": scid, "domain": domain, "user_prompt": prompt,
        "evidence": evidence, "root_concepts": [c.lower() for c in root_concepts],
        "rejected": [c.lower() for c in rejected], "required_evidence": required,
        "causal_evidence": causal, "remediation_class": [r.lower() for r in remed_class],
        "prohibited": prohib, "groups": groups, "difficulty": diff, "expected_min_useful_calls": min_calls})

