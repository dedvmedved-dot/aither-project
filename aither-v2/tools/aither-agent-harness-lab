                tool("kubectl_describe","describe pod",{"pod":{"type":"string"},"namespace":{"type":"string"}},["pod"]),
                tool("kubectl_logs","pod logs",{"pod":{"type":"string"},"namespace":{"type":"string"}},["pod"])],
