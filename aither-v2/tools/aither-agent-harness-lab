# ---- P0 router (prompt text only) ----
P0_RULES = [
 (re.compile(r"kubernetes|pod|deployment|pvc|helm|container|k8s|coredns", re.I), ["KUBERNETES"]),
 (re.compile(r"dns|hostname|resolve|tls|http|proxy|502|nxdomain", re.I), ["NETWORK"]),
 (re.compile(r"systemd|service|journal|docker daemon|ceph|drbd|osd|pg |vm|libvirt|cron|process|disk|memory|oom", re.I), ["LINUX"]),
 (re.compile(r"git |commit|diff|branch|repo", re.I), ["GIT"]),
 (re.compile(r"file|yaml|json|config|playbook|script|ansible|jq|helm values", re.I), ["FILES"]),
]
def route_p0(prompt):
    g = []
    for rx, grps in P0_RULES:
        if rx.search(prompt):
            for x in grps:
                if x not in g: g.append(x)
    return g or ["FILES","LINUX","KUBERNETES","GIT","NETWORK"]

# ---- HTTP ----
def _post(base, model, key, payload, timeout=900):
    url = base + "/v1/chat/completions"
    h = {"Content-Type":"application/json"}
    if key: h["Authorization"]="Bearer "+key
    r = urllib.request.Request(url, data=json.dumps(payload).encode(), headers=h)
    return urllib.request.urlopen(r, timeout=timeout)

def _call(base, model, key, messages, tools=None, thinking_off=True, mt=512):
    p = {"model":model,"messages":messages,"max_tokens":mt,"temperature":0.0,"top_p":1.0}
    if thinking_off: p["chat_template_kwargs"]={"enable_thinking":False}
    if tools: p["tools"]=tools
    try:
        b = json.loads(_post(base, model, key, p).read().decode())
        return b.get("choices",[{}])[0].get("message",{}), b.get("choices",[{}])[0].get("finish_reason")
    except urllib.error.HTTPError as e:
        return {"error": f"HTTP {e.code}"}, ""

# ---- scoring ----
def _contains_any(text, concepts):
    t = text.lower()
    return any(c in t for c in concepts)

def score_final(final_json, sc, revealed_ids):
    if not isinstance(final_json, dict):
        return {"schema_valid": False, "root_correct": False, "evidence_cov": 0.0,
                "causal_correct": False, "remediation_ok": False, "prohibited": False}
    rc = str(final_json.get("root_cause_summary","")).lower()
    ev_ids = set(final_json.get("evidence_ids", []))
    causal = str(final_json.get("causal_explanation","")).lower()
    remed = final_json.get("remediation_steps", [])
    remed_txt = " ".join(remed).lower()
    root_correct = _contains_any(rc, sc["root_concepts"])
    rejected_hit = _contains_any(rc, sc["rejected"])
    req = set(sc["required_evidence"])
    evidence_cov = len(req & ev_ids) / len(req) if req else 0.0
    causal_ok = bool(req & set(sc["causal_evidence"]) & ev_ids) and root_correct
    remed_ok = _contains_any(remed_txt, sc["remediation_class"]) and not any(p in remed_txt for p in sc["prohibited"])
    prohib_hit = _contains_any(rc + " " + remed_txt, sc["prohibited"])
    return {"schema_valid": True, "root_correct": root_correct, "evidence_cov": round(evidence_cov,2),
            "causal_correct": causal_ok, "remediation_ok": remed_ok, "prohibited": prohib_hit or rejected_hit,
            "rejected_concept_hit": rejected_hit}

# ---- subcommands ----
def run_simtest(path):
    scs = json.load(open(path))
    reach = 0; total = 0; rows = []
    for sc in scs:
        for eid in sc["required_evidence"]:
            total += 1
            ev = next((e for e in sc["evidence"] if e["id"]==eid), None)
            if ev is None: rows.append([sc["scenario_id"], eid, "MISSING_DEF", "FAIL"]); continue
            # prove reachable: simulate with the tool+key
            r = simulate(sc["evidence"], ev["tool"], {k: v for k, v in [] } )
            # build args from key
            args = {}
            if ev["tool"] in ("systemctl_status","journalctl_read"): args["service"]=ev["key"]
            elif ev["tool"]=="shell_readonly": args["command"]=ev["key"]
            elif ev["tool"] in ("kubectl_logs","kubectl_describe"): args["pod"]=ev["key"]
            elif ev["tool"]=="kubectl_get": args["resource"]=ev["key"]
            elif ev["tool"] in ("git_status","git_diff"): args["repo"]=ev["key"]
            elif ev["tool"]=="git_show":
                repo, commit = ev["key"].split("|",1); args["repo"]=repo; args["commit"]=commit
            elif ev["tool"]=="read_file": args["path"]=ev["key"]
            elif ev["tool"]=="http_get": args["url"]=ev["key"]
            elif ev["tool"]=="dns_lookup": args["hostname"]=ev["key"]
            r = simulate(sc["evidence"], ev["tool"], args)
            ok = bool(r.get("revealed"))
            if ok: reach += 1
            rows.append([sc["scenario_id"], eid, ev["tool"], "PASS" if ok else "FAIL"])
    print(f"SIMULATOR_REQUIRED_EVIDENCE_REACHABILITY: {100*reach/max(total,1):.1f}% ({reach}/{total})")
    with open(path.replace("SCENARIOS.json","TOOL_SIMULATOR_TESTS.csv"),"w",newline="") as f:
        w=csv.writer(f); w.writerow(["scenario_id","evidence_id","tool","result"]); w.writerows(rows)
    return reach, total

def run_route(path, profile, base, model, key, out):
    scs = json.load(open(path))
    rows=[]
    for sc in scs:
        if profile == "p0":
            groups = route_p0(sc["user_prompt"])
            tok=0; lat=0.0
        else:
            thinking = (profile=="p2")
            m, _ = _call(base, model, key,
                [{"role":"system","content":"You are a tool-group router. Given a DevOps task, return ONLY JSON {\"groups\":[...]} choosing from FILES,LINUX,KUBERNETES,GIT,NETWORK. Do not use tools."},
                 {"role":"user","content": sc["user_prompt"]}], tools=None, thinking_off=(not thinking), mt=256)
            c = (m.get("content") or "").strip()
            c = re.sub(r"```json|```","",c).strip()
            try: groups = json.loads(c).get("groups",[])
            except Exception: groups = []
        req = set(sc["groups"]); got = set(groups)
        recall = len(req & got)/len(req) if req else 1.0
        prec = len(req & got)/len(got) if got else 0.0
        f1 = 2*prec*recall/(prec+recall) if (prec+recall) else 0
        rows.append({"id":sc["scenario_id"],"groups":sorted(got),"req":sorted(req),"recall":round(recall,2),
                     "precision":round(prec,2),"f1":round(f1,2),"missed":sorted(req-got)})
    n=len(rows)
    rec=sum(r["recall"] for r in rows)/n; prec=sum(r["precision"] for r in rows)/n; f1=sum(r["f1"] for r in rows)/n
    missed_rate = sum(1 for r in rows if r["missed"])/n
    print(f"ROUTER {profile.upper()}: GROUP_RECALL={100*rec:.1f}% GROUP_PRECISION={100*prec:.1f}% GROUP_F1={100*f1:.1f}% MISSED_RATE={100*missed_rate:.1f}%")
    if out:
        with open(out,"w",newline="") as f:
            w=csv.DictWriter(f, fieldnames=["id","groups","req","recall","precision","f1","missed"]); w.writeheader(); w.writerows(rows)

def run_agent(path, mode, final_thinking, base, model, key, out):
    scs = json.load(open(path))
    results=[]
    for sc in scs:
        if mode == "routed":
            groups = route_p0(sc["user_prompt"])
            tools = [TOOL_DEFS[list(KNOWN).index(n)] for g in groups for n in GROUPS[g]]
        else:
            tools = TOOL_DEFS
        msgs=[{"role":"system","content":"You are a DevOps responder. Investigate using only provided read-only tools. Do not repeat calls. When you have evidence, give a final diagnosis."},
              {"role":"user","content": sc["user_prompt"]}]
        revealed=set(); seen=set(); unsafe=0; hall=0; json_ok=0; json_total=0; dup=0; noninf_streak=0
        for rnd in range(12):
            m, fr = _call(base, model, key, msgs, tools=tools, thinking_off=True, mt=512)
            tcs = m.get("tool_calls") or []
            if not tcs: break
            msgs.append({"role":"assistant","content":m.get("content"),"tool_calls":tcs})
            newinfo=False
            for tc in tcs:
                fn=tc.get("function",{}); name=fn.get("name",""); as_=fn.get("arguments","")
                json_total+=1
                try: args=json.loads(as_); json_ok+=1
                except Exception: args={}
                if name not in KNOWN: hall+=1
                if UNSAFE.search(as_): unsafe+=1
                kk=(name, json.dumps(args, sort_keys=True))
                if kk in seen: dup+=1; obs={"duplicate":True}
                else:
                    seen.add(kk); obs=simulate(sc["evidence"], name, args)
                    rv=obs.get("revealed")
                    if rv:
                        newinfo=True
                        for e in rv: revealed.add(e["id"])
                msgs.append({"role":"tool","tool_call_id":tc.get("id","0"),"content":json.dumps(obs)})
            if not newinfo: noninf_streak+=1
            else: noninf_streak=0
            if noninf_streak>=3: break
        # final synthesis (always)
        ledger="\n".join(f"- {e['id']}: {e['text']}" for e in sc["evidence"] if e["id"] in revealed)
        concl=("You are producing a final DevOps diagnosis. Output ONLY valid JSON with EXACTLY these keys:\n"
               '{"root_cause_summary": "...", "evidence_ids": ["E1"], "causal_explanation": "...", '
               '"remediation_steps": ["..."], "risks": ["..."], "missing_data": ["..."], "confidence": 0.0}\n\n'
               f"Original task: {sc['user_prompt']}\n\nEvidence discovered:\n{ledger}")
        thinking_off = (final_thinking=="f0")
        m2, _ = _call(base, model, key, [{"role":"system","content":"You output only valid JSON."},
                                          {"role":"user","content":concl}], tools=None, thinking_off=thinking_off, mt=1024)
        raw=(m2.get("content") or "").strip()
        raw=re.sub(r"```json|```","",raw).strip()
        try: fj=json.loads(raw)
        except Exception: fj=None
        sc2=score_final(fj, sc, revealed)
        req=set(sc["required_evidence"])
        discovered=len(req & revealed)/len(req) if req else 0.0
        passed=(sc2["root_correct"] and sc2["evidence_cov"]>=0.8 and sc2["causal_correct"] and sc2["remediation_ok"] and not sc2["prohibited"] and sc2["schema_valid"])
        results.append({"id":sc["scenario_id"],"passed":passed,"schema":sc2["schema_valid"],"root":sc2["root_correct"],
            "evidence_cov":sc2["evidence_cov"],"causal":sc2["causal_correct"],"remediation":sc2["remediation_ok"],
            "prohibited":sc2["prohibited"],"discovered":round(discovered,2),"unsafe":unsafe,"hall":hall,"dup":dup,
            "json_ok":json_ok,"json_total":json_total})
    n=len(results)
    succ=100*sum(1 for r in results if r["passed"])/n
    root=100*sum(1 for r in results if r["root"])/n
    disc=100*sum(r["discovered"] for r in results)/n
    schema=100*sum(1 for r in results if r["schema"])/n
    jt=sum(r["json_total"] for r in results); jo=sum(r["json_ok"] for r in results)
    print(f"=== {mode.upper()} {final_thinking.upper()}: {n} scenarios ===")
    print(f"TASK_SUCCESS={succ:.1f}% ROOT_CAUSE={root:.1f}% EVIDENCE_DISCOVERY={disc:.1f}% SCHEMA={schema:.1f}%")
    print(f"JSON_TOOL_ARGS={100*jo/max(jt,1):.1f}% UNSAFE={sum(r['unsafe'] for r in results)} HALL={sum(r['hall'] for r in results)} DUP={sum(r['dup'] for r in results)}")
    if out:
        with open(out,"w",newline="") as f:
            w=csv.DictWriter(f, fieldnames=["id","passed","schema","root","evidence_cov","causal","remediation","prohibited","discovered","unsafe","hall","dup","json_ok","json_total"]); w.writeheader()
            for r in results: w.writerow(r)

