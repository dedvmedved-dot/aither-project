def selfcheck():
    assert len(TOOL_DEF_BY_NAME) == 14, "tool map"
    # semantic equivalence smoke (D1/D4)
    assert parse_operation("systemctl_status", {"service": "nginx"})[0] == \
           parse_operation("systemctl_status", {"service": "nginx.service"})[0], ".service"
    assert parse_operation("dns_lookup", {"hostname": "X.COM."})[0] == \
           parse_operation("dns_lookup", {"hostname": "x.com"})[0], "dns case/dot"
    assert parse_operation("shell_readonly", {"command": "ceph -s"})[0] == \
           parse_operation("shell_readonly", {"command": "ceph status"})[0], "ceph -s/status"
    assert parse_operation("shell_readonly", {"command": "df -h"})[0]["type"] == "disk_usage_filesystem"
    # D2: namespace identity
    assert parse_operation("kubectl_get", {"resource": "pods", "namespace": "prod"})[0] != \
           parse_operation("kubectl_get", {"resource": "pods", "namespace": "kube-system"})[0], "namespace"
    print("TOOL_SCHEMA_MAP: 14/14")
    print("SEMANTIC_OPERATION_MODEL: PASS")


