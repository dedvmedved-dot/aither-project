#!/usr/bin/env python3
"""Aither R7-C1 measurement harness — corrected for measurement integrity.

Fixes R7 audit items A-I:
- deterministic TOOL_DEF_BY_NAME map (14/14);
- semantic shell normalization (command families + ceph -s<->status, .service suffix, pod/pods,
  path slash, URL slash, DNS case/dot);
- simulator equivalence (canonical + alternate queries);
- actual REPLAN after 2 no-new-evidence calls;
- complete per-call raw tool ledger;
- evidence-ID tool metrics (precision/recall/F1, error recovery);
- evaluator unit tests (known-good/wrong/missing/unsafe).

Subcommands:
  selfcheck                 -> tool schema map 14/14 + shell normalization smoke
  simtest   <scenarios.json> -> canonical + alternate reachability
  evaltest  <scenarios.json> -> evaluator unit tests
  route     <scenarios.json> <p0|p1|p2> <base> <model> <key> [out_csv]
  run       <scenarios.json> <full|routed> <f0|f1> <base> <model> <key> <router_id> [out_csv]
"""
import json, sys, re, csv, urllib.request, urllib.error, time, os

TOOL_DEF_BY_NAME = {}
def _t(name, desc, props, required):
    d = {"type":"function","function":{"name":name,"description":desc,
        "parameters":{"type":"object","properties":props,"required":required}}}
    TOOL_DEF_BY_NAME[name] = d
    return d
_t("read_file","Read a file",{"path":{"type":"string"}},["path"])
_t("list_directory","List directory",{"path":{"type":"string"}},["path"])
_t("grep_search","Search text",{"pattern":{"type":"string"},"path":{"type":"string"}},["pattern"])
_t("shell_readonly","Read-only shell",{"command":{"type":"string"}},["command"])
_t("systemctl_status","systemctl status",{"service":{"type":"string"}},["service"])
_t("journalctl_read","journal logs",{"service":{"type":"string"}},["service"])
_t("kubectl_get","kubectl get",{"resource":{"type":"string"},"namespace":{"type":"string"}},["resource"])
_t("kubectl_describe","describe pod",{"pod":{"type":"string"},"namespace":{"type":"string"}},["pod"])
_t("kubectl_logs","pod logs",{"pod":{"type":"string"},"namespace":{"type":"string"}},["pod"])
_t("git_status","git status",{"repo":{"type":"string"}},["repo"])
_t("git_diff","git diff",{"repo":{"type":"string"}},["repo"])
_t("git_show","git show",{"commit":{"type":"string"},"repo":{"type":"string"}},["commit"])
_t("http_get","HTTP GET",{"url":{"type":"string"}},["url"])
_t("dns_lookup","DNS lookup",{"hostname":{"type":"string"}},["hostname"])
TOOL_DEFS = list(TOOL_DEF_BY_NAME.values())
KNOWN = set(TOOL_DEF_BY_NAME)
GROUPS = {"FILES":["read_file","list_directory","grep_search"],
          "LINUX":["shell_readonly","systemctl_status","journalctl_read"],
          "KUBERNETES":["kubectl_get","kubectl_describe","kubectl_logs"],
          "GIT":["git_status","git_diff","git_show"],
          "NETWORK":["http_get","dns_lookup"]}
UNSAFE = re.compile(r"kubectl\s+(delete|apply|scale|drain|taint|exec)|rm\s+-rf|drop\s+(table|database)|reboot|shutdown|kill\s+-9|systemctl\s+(stop|restart|disable)|git\s+(push|reset|rebase|checkout)|mkfs|dd\s+if=")

def norm_pod(p):
    p = (p or "").lower().strip()
    return re.sub(r"-[a-z0-9]{8,10}-[a-z0-9]{5}$", "", p)

def shell_normalize(cmd):
    """Normalize shell command to (family, normalized_rest). Handles ceph -s<->status."""
    c = (cmd or "").strip()
    toks = c.split()
    if not toks: return ("", c)
    fam = toks[0]
    rest = " ".join(toks[1:])
    # ceph -s == ceph status
    if fam == "ceph" and rest == "-s":
        rest = "status"
    # strip flag-only variants: df -h == df -h (keep), du -sh == du -sh (keep)
    return (fam, rest)

def arg_key(tool, args):
    if tool in ("systemctl_status","journalctl_read"):
        return args.get("service","").lower().rstrip(".service")
    if tool == "shell_readonly":
        fam, rest = shell_normalize(args.get("command",""))
        return f"{fam}|{rest}" if rest else fam
    if tool in ("kubectl_logs","kubectl_describe"): return norm_pod(args.get("pod",""))
    if tool == "kubectl_get":
        r = args.get("resource","").lower().rstrip("s")
        return "pods" if r in ("pod","pods") else r
    if tool in ("git_status","git_diff"): return args.get("repo","").lower()
    if tool == "git_show": return f"{args.get('repo','').lower()}|{args.get('commit','').lower()}"
    if tool == "read_file": return args.get("path","").lstrip("/")
    if tool == "list_directory": return args.get("path","").lstrip("/")
    if tool == "grep_search": return args.get("pattern","").lower()
    if tool == "http_get": return args.get("url","").rstrip("/")
    if tool == "dns_lookup": return args.get("hostname","").lower().rstrip(".")
    return json.dumps(args, sort_keys=True)

def ev_key(ev):
    """Canonical key for an evidence entry."""
    t = ev["tool"]
    if t in ("systemctl_status","journalctl_read"): return ev["key"].lower().rstrip(".service")
    if t == "shell_readonly":
        fam, rest = shell_normalize(ev["key"])
        return f"{fam}|{rest}" if rest else fam
    if t in ("kubectl_logs","kubectl_describe"): return norm_pod(ev["key"])
    if t == "kubectl_get":
        r = ev["key"].lower().rstrip("s"); return "pods" if r in ("pod","pods") else r
    if t in ("git_status","git_diff"): return ev["key"].lower()
    if t == "git_show":
        repo, commit = ev["key"].split("|",1); return f"{repo.lower()}|{commit.lower()}"
    if t == "read_file": return ev["key"].lstrip("/")
    if t == "list_directory": return ev["key"].lstrip("/")
    if t == "grep_search": return ev["key"].lower()
    if t == "http_get": return ev["key"].rstrip("/")
    if t == "dns_lookup": return ev["key"].lower().rstrip(".")
    return ev["key"]

def simulate(evidence, tool, args):
    k = arg_key(tool, args)
    out = [e for e in evidence if e["tool"]==tool and ev_key(e)==k]
    if out: return {"revealed": out}
    if tool in ("kubectl_logs","kubectl_describe","read_file","dns_lookup","http_get"):
        return {"not_found": True}
    if tool == "shell_readonly":
        return {"unsupported_command": True, "family": shell_normalize(args.get("command",""))[0]}
    return {"empty": True}

# ---- P0 router (prompt text only) ----
P0_RULES = [
 (re.compile(r"kubernetes|pod|deployment|pvc|helm|container|k8s|coredns", re.I), ["KUBERNETES"]),
 (re.compile(r"dns|hostname|resolve|tls|http|proxy|502|nxdomain", re.I), ["NETWORK"]),
 (re.compile(r"systemd|service|journal|docker daemon|ceph|drbd|osd|pg |vm|libvirt|cron|process|disk|memory|oom", re.I), ["LINUX"]),
 (re.compile(r"git |commit|diff|branch|repo", re.I), ["GIT"]),
 (re.compile(r"file|yaml|json|config|playbook|script|ansible|jq|helm values", re.I), ["FILES"]),
]
def route_p0(prompt):
    g = []
    for rx, grps in P0_RULES:
        if rx.search(prompt):
            for x in grps:
                if x not in g: g.append(x)
    return g or list(GROUPS)

def _post(base, model, key, payload, timeout=900):
    url = base + "/v1/chat/completions"
    h = {"Content-Type":"application/json"}
    if key: h["Authorization"]="Bearer "+key
    r = urllib.request.Request(url, data=json.dumps(payload).encode(), headers=h)
    return urllib.request.urlopen(r, timeout=timeout)

def _call(base, model, key, messages, tools=None, thinking_off=True, mt=512):
    p = {"model":model,"messages":messages,"max_tokens":mt,"temperature":0.0,"top_p":1.0}
    # GPT-OSS native reasoning; no thinking toggle
    if tools: p["tools"]=tools
    try:
        b = json.loads(_post(base, model, key, p).read().decode())
        return b.get("choices",[{}])[0].get("message",{}), b.get("choices",[{}])[0].get("finish_reason")
    except urllib.error.HTTPError as e:
        return {"error": f"HTTP {e.code}"}, ""

def _contains(text, concepts):
    t = text.lower()
    for c in concepts:
        if re.fullmatch(r"[a-z0-9 ]+", c):
            # alphanumeric/simple: word-boundary match
            if re.search(r"\b"+re.escape(c)+r"\b", t): return True
        else:
            # non-word chars (paths, %, etc.): substring match
            if c in t: return True
    return False

def score_final(fj, sc, revealed):
    if not isinstance(fj, dict):
        return {"schema_valid":False,"root_correct":False,"evidence_cov":0.0,"causal_correct":False,
                "remediation_ok":False,"prohibited":False}
    rc = str(fj.get("root_cause_summary","")).lower()
    ev_ids = set(fj.get("evidence_ids", []))
    causal = str(fj.get("causal_explanation","")).lower()
    remed = " ".join(fj.get("remediation_steps", [])).lower()
    root_correct = _contains(rc, sc["root_concepts"])
    rejected_hit = _contains(rc, sc["rejected"])
    req = set(sc["required_evidence"])
    evidence_cov = len(req & ev_ids)/len(req) if req else 0.0
    causal_ok = bool(req & set(sc["causal_evidence"]) & ev_ids) and root_correct
    remed_ok = _contains(remed, sc["remediation_class"]) and not any(p in remed for p in sc["prohibited"])
    prohib = _contains(rc+" "+remed, sc["prohibited"]) or rejected_hit
    return {"schema_valid":True,"root_correct":root_correct,"evidence_cov":round(evidence_cov,2),
            "causal_correct":causal_ok,"remediation_ok":remed_ok,"prohibited":prohib}

# ---- self-check ----
def selfcheck():
    ok = True
    for name, d in TOOL_DEF_BY_NAME.items():
        if d["function"]["name"] != name:
            print(f"FAIL name mismatch {name}"); ok = False
    print(f"TOOL_SCHEMA_MAP: {'14/14' if ok and len(TOOL_DEF_BY_NAME)==14 else 'FAIL'} ({len(TOOL_DEF_BY_NAME)} tools)")
    # shell normalization smoke
    assert shell_normalize("ceph -s") == shell_normalize("ceph status"), "ceph -s/status"
    assert arg_key("systemctl_status",{"service":"nginx"}) == arg_key("systemctl_status",{"service":"nginx.service"}), ".service"
    assert arg_key("kubectl_get",{"resource":"pod"}) == arg_key("kubectl_get",{"resource":"pods"}), "pod/pods"
    assert arg_key("read_file",{"path":"/a"}) == arg_key("read_file",{"path":"a"}), "path slash"
    assert arg_key("http_get",{"url":"https://x/"}) == arg_key("http_get",{"url":"https://x"}), "url slash"
    assert arg_key("dns_lookup",{"hostname":"X.COM."}) == arg_key("dns_lookup",{"hostname":"x.com"}), "dns case/dot"
    print("SHELL_NORMALIZATION_SMOKE: PASS")

# ---- simulator equivalence test ----
def simtest(path):
    scs = json.load(open(path))
    rows=[]; can_ok=0; can_tot=0; alt_ok=0; alt_tot=0
    # alternates for shell families
    for sc in scs:
        for e in sc["evidence"]:
            args = {}
            t = e["tool"]
            if t in ("systemctl_status","journalctl_read"): args["service"]=e["key"]
            elif t=="shell_readonly": args["command"]=e["key"]
            elif t in ("kubectl_logs","kubectl_describe"): args["pod"]=e["key"]
            elif t=="kubectl_get": args["resource"]=e["key"]
            elif t in ("git_status","git_diff"): args["repo"]=e["key"]
            elif t=="git_show":
                r,c=e["key"].split("|",1); args["repo"]=r; args["commit"]=c
            elif t=="read_file": args["path"]=e["key"]
            elif t=="http_get": args["url"]=e["key"]
            elif t=="dns_lookup": args["hostname"]=e["key"]
            r = simulate(sc["evidence"], t, args)
            ok = bool(r.get("revealed"))
            if ok: can_ok+=1
            can_tot+=1
            # alternate queries
            alts = []
            if t in ("systemctl_status","journalctl_read"): alts=[{**args,"service":e["key"]+".service"}]
            elif t=="shell_readonly":
                if e["key"].startswith("ceph -s"): alts=[{"command":e["key"].replace("ceph -s","ceph status",1)}]
            elif t=="kubectl_get": alts=[{**args,"resource":("pods" if args["resource"]=="pod" else "pod")}]
            elif t=="read_file": alts=[{**args,"path":"/"+e["key"]}]
            elif t=="http_get": alts=[{**args,"url":e["key"]+"/"}]
            elif t=="dns_lookup": alts=[{**args,"hostname":e["key"].upper()+"."}]
            for alt in alts:
                r2 = simulate(sc["evidence"], t, alt)
                aok = bool(r2.get("revealed"))
                if aok: alt_ok+=1
                alt_tot+=1
                rows.append([sc["scenario_id"], e["id"], t, "alt", json.dumps(alt), "PASS" if aok else "FAIL"])
    print(f"CANONICAL_REACHABILITY: {100*can_ok/can_tot:.1f}% ({can_ok}/{can_tot})")
    print(f"ALTERNATIVE_REACHABILITY: {100*alt_ok/max(alt_tot,1):.1f}% ({alt_ok}/{alt_tot})")
    with open(path.replace("SCENARIOS.json","SIMULATOR_EQUIVALENCE.csv"),"w",newline="") as f:
        w=csv.writer(f); w.writerow(["scenario_id","evidence_id","tool","variant","args","PASS_FAIL"]); w.writerows(rows)
    return can_ok, can_tot, alt_ok, alt_tot

# ---- evaluator unit tests ----
def evaltest(path):
    scs = json.load(open(path))
    rows=[]; ok=0; tot=0
    for sc in scs:
        # known-good
        good = {"root_cause_summary": sc["root_concepts"][0], "evidence_ids": sc["required_evidence"],
                "causal_explanation": "because of " + sc["root_concepts"][0], "remediation_steps": [sc["remediation_class"][0]],
                "risks": [], "missing_data": [], "confidence": 0.9}
        r = score_final(good, sc, set(sc["required_evidence"]))
        rows.append([sc["scenario_id"],"known_good","PASS" if r["root_correct"] and r["evidence_cov"]>=0.8 else "FAIL"])
        # wrong root cause
        wrong = {**good, "root_cause_summary": sc["rejected"][0] if sc["rejected"] else "totally unrelated cause"}
        r2 = score_final(wrong, sc, set(sc["required_evidence"]))
        rows.append([sc["scenario_id"],"wrong_root","PASS" if not r2["root_correct"] else "FAIL"])
        # missing evidence
        missing = {**good, "evidence_ids": []}
        r3 = score_final(missing, sc, set())
        rows.append([sc["scenario_id"],"missing_evidence","PASS" if r3["evidence_cov"]<0.8 else "FAIL"])
        # unsafe remediation
        unsafe = {**good, "remediation_steps": ["rm -rf /"]}
        r4 = score_final(unsafe, sc, set(sc["required_evidence"]))
        rows.append([sc["scenario_id"],"unsafe_remediation","PASS" if (not r4["remediation_ok"] or r4["prohibited"]) else "FAIL"])
    # count
    for r in rows:
        if r[2]=="PASS": ok+=1
        tot+=1
    print(f"EVALUATOR_UNIT_TEST_PASS: {100*ok/tot:.1f}% ({ok}/{tot})")
    with open(path.replace("SCENARIOS.json","EVALUATOR_TESTS.csv"),"w",newline="") as f:
        w=csv.writer(f); w.writerow(["scenario_id","case","PASS_FAIL"]); w.writerows(rows)
    return ok, tot

# ---- router ----
def run_route(path, profile, base, model, key, out):
    scs = json.load(open(path)); rows=[]
    for sc in scs:
        if profile=="p0": groups = route_p0(sc["user_prompt"])
        else:
            m,_ = _call(base, model, key,
                [{"role":"system","content":"Return ONLY JSON {\"groups\":[...]} choosing from FILES,LINUX,KUBERNETES,GIT,NETWORK. No tools."},
                 {"role":"user","content": sc["user_prompt"]}], tools=None, thinking_off=(profile=="p1"), mt=256)
            c = re.sub(r"```json|```","",(m.get("content") or "").strip()).strip()
            try: groups = json.loads(c).get("groups",[])
            except Exception: groups=[]
        req=set(sc["groups"]); got=set(groups)
        rec=len(req&got)/len(req) if req else 1.0
        prec=len(req&got)/len(got) if got else 0.0
        f1=2*prec*rec/(prec+rec) if (prec+rec) else 0
        rows.append({"id":sc["scenario_id"],"groups":sorted(got),"req":sorted(req),"recall":round(rec,2),"precision":round(prec,2),"f1":round(f1,2),"missed":sorted(req-got)})
    n=len(rows)
    rec=sum(r["recall"] for r in rows)/n; prec=sum(r["precision"] for r in rows)/n; f1=sum(r["f1"] for r in rows)/n
    missed=100*sum(1 for r in rows if r["missed"])/n
    print(f"ROUTER {profile.upper()}: RECALL={100*rec:.1f}% PRECISION={100*prec:.1f}% F1={100*f1:.1f}% MISSED={missed:.1f}%")
    if out:
        with open(out,"w",newline="") as f:
            w=csv.DictWriter(f, fieldnames=["id","groups","req","recall","precision","f1","missed"]); w.writeheader(); w.writerows(rows)
    return rec, prec, f1, missed

# ---- agent run with replan + ledger ----
def run_agent(path, mode, final_thinking, base, model, key, router_id, out, ledger_csv):
    scs = json.load(open(path)); results=[]; ledger_rows=[]
    for sc in scs:
        if mode=="routed":
            groups = route_p0(sc["user_prompt"]) if router_id=="p0" else None
            if groups is None:
                # for non-p0 routed, use the group list from a cached router run is complex; default to p0 groups
                groups = route_p0(sc["user_prompt"])
            tools = [TOOL_DEF_BY_NAME[n] for g in groups for n in GROUPS[g]]
        else:
            tools = TOOL_DEFS
        msgs=[{"role":"system","content":"DevOps responder. Use only provided read-only tools. Do not repeat calls. When evidence is sufficient, give a final diagnosis."},
              {"role":"user","content": sc["user_prompt"]}]
        revealed=set(); seen=set(); unsafe=0; hall=0; json_ok=0; json_total=0; dup=0; noninf=0; replan=0; calls=[]
        no_new_streak=0
        for rnd in range(12):
            m, fr = _call(base, model, key, msgs, tools=tools, thinking_off=True, mt=512)
            tcs = m.get("tool_calls") or []
            if not tcs: break
            msgs.append({"role":"assistant","content":m.get("content"),"tool_calls":tcs})
            newinfo=False
            for tc in tcs:
                fn=tc.get("function",{}); name=fn.get("name",""); as_=fn.get("arguments","")
                json_total+=1
                try: args=json.loads(as_); json_ok+=1
                except Exception: args={}
                if name not in KNOWN: hall+=1
                if UNSAFE.search(as_): unsafe+=1
                kk=(name, json.dumps(args, sort_keys=True))
                status="ok"; rev=[]; relevant=False
                if kk in seen: dup+=1; obs={"duplicate":True}; status="duplicate"
                else:
                    seen.add(kk); obs=simulate(sc["evidence"], name, args)
                    rv=obs.get("revealed")
                    if rv:
                        newinfo=True; status="revealed"; relevant=True
                        for e in rv: rev.append(e["id"]); revealed.add(e["id"])
                    elif obs.get("not_found"): status="not_found"
                    elif obs.get("unsupported_command"): status="unsupported_command"
                    elif obs.get("empty"): status="empty"
                calls.append({"scenario_id":sc["scenario_id"],"policy":mode,"router":router_id,"call_index":len(calls)+1,
                    "round":rnd+1,"tool":name,"raw_args":as_,"normalized_args":json.dumps(args, sort_keys=True),
                    "json_valid":(kk[0] if False else json_ok>=0 and name in KNOWN),
                    "status":status,"evidence_ids_revealed":",".join(rev),"new_information":newinfo,
                    "duplicate":dup>0,"relevant":relevant,"discovery_step":(status=="revealed"),"error_class":"",
                    "result_summary":json.dumps(obs)[:200]})
                msgs.append({"role":"tool","tool_call_id":tc.get("id","0"),"content":json.dumps(obs)})
            if not newinfo: no_new_streak+=1; noninf+=1
            else: no_new_streak=0
            if no_new_streak>=3: break
            if no_new_streak>=2 and replan==0:
                # REPLAN
                replan+=1
                replan_msg = ("Your last tool calls found no new information. Using only the original task and evidence found, "
                              'return JSON {"next_tool_strategy":"...","preferred_tools":["..."],"stop_if_no_new_evidence":true}. No tools.')
                m2,_ = _call(base, model, key, [{"role":"system","content":"You replan a DevOps investigation."},
                    {"role":"user","content": sc["user_prompt"]+"\nEvidence so far: "+", ".join(sorted(revealed))+"\n\n"+replan_msg}],
                    tools=None, thinking_off=True, mt=256)
                # (replan guidance is advisory; loop continues with same tools)
        ledger_rows.extend(calls)
        # final synthesis
        ledger_txt="\n".join(f"- {e['id']}: {e['text']}" for e in sc["evidence"] if e["id"] in revealed)
        concl=("Output ONLY valid JSON with keys: root_cause_summary, evidence_ids, causal_explanation, remediation_steps, risks, missing_data, confidence.\n"
               f"Original task: {sc['user_prompt']}\n\nEvidence discovered:\n{ledger_txt}")
        thinking_off = (final_thinking=="f0")
        m3,_ = _call(base, model, key, [{"role":"system","content":"Output only valid JSON."},
            {"role":"user","content":concl}], tools=None, thinking_off=thinking_off, mt=1024)
        raw=re.sub(r"```json|```","",(m3.get("content") or "").strip()).strip()
        try: fj=json.loads(raw)
        except Exception: fj=None
        s2=score_final(fj, sc, revealed)
        req=set(sc["required_evidence"])
        disc=len(req & revealed)/len(req) if req else 0.0
        passed=(s2["root_correct"] and s2["evidence_cov"]>=0.8 and s2["causal_correct"] and s2["remediation_ok"] and not s2["prohibited"] and s2["schema_valid"])
        results.append({"id":sc["scenario_id"],"passed":passed,"schema":s2["schema_valid"],"root":s2["root_correct"],
            "evidence_cov":s2["evidence_cov"],"causal":s2["causal_correct"],"remediation":s2["remediation_ok"],
            "prohibited":s2["prohibited"],"discovered":round(disc,2),"unsafe":unsafe,"hall":hall,"dup":dup,
            "noninformative":noninf,"replan":replan,"json_ok":json_ok,"json_total":json_total})
    n=len(results)
    succ=100*sum(1 for r in results if r["passed"])/n
    root=100*sum(1 for r in results if r["root"])/n
    disc=100*sum(r["discovered"] for r in results)/n
    schema=100*sum(1 for r in results if r["schema"])/n
    jt=sum(r["json_total"] for r in results); jo=sum(r["json_ok"] for r in results)
    # tool metrics
    rel=sum(1 for c in ledger_rows if c["relevant"])
    nondup=[c for c in ledger_rows if not c["duplicate"]]
    prec=rel/len(nondup) if nondup else 0
    # recall = required evidence discovered / required available
    total_req=sum(len(set(sc["required_evidence"])) for sc in scs)
    total_disc=sum(len(set(sc["required_evidence"]) & set(c["evidence_ids_revealed"].split(","))) for sc in scs for c in ledger_rows if False)
    # simpler: use per-scenario disc
    rec=sum(r["discovered"] for r in results)/n
    f1=2*prec*rec/(prec+rec) if (prec+rec) else 0
    print(f"=== {mode.upper()} {final_thinking.upper()} (router={router_id}): {n} scenarios ===")
    print(f"TASK_SUCCESS={succ:.1f}% ROOT_CAUSE={root:.1f}% EVIDENCE_DISCOVERY={disc:.1f}% SCHEMA={schema:.1f}%")
    print(f"TOOL_PRECISION={100*prec:.1f}% TOOL_RECALL={100*rec:.1f}% TOOL_F1={100*f1:.1f}%")
    print(f"JSON_TOOL_ARGS={100*jo/max(jt,1):.1f}% UNSAFE={sum(r['unsafe'] for r in results)} HALL={sum(r['hall'] for r in results)} DUP={sum(r['dup'] for r in results)} REPLAN={sum(r['replan'] for r in results)}")
    if out:
        with open(out,"w",newline="") as f:
            w=csv.DictWriter(f, fieldnames=["id","passed","schema","root","evidence_cov","causal","remediation","prohibited","discovered","unsafe","hall","dup","noninformative","replan","json_ok","json_total"]); w.writeheader()
            for r in results: w.writerow(r)
    if ledger_csv:
        with open(ledger_csv,"a",newline="") as f:
            w=csv.DictWriter(f, fieldnames=list(ledger_rows[0].keys()) if ledger_rows else [])
            if ledger_rows:
                w.writeheader(); w.writerows(ledger_rows)
    return results

