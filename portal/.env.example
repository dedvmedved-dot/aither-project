# Aither Portal — Environment Configuration

# === REQUIRED: Generate a cryptographically strong random secret for JWT ===
# Linux/macOS: openssl rand -hex 32
#                 or: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-random-64-hex-char-secret

# === REQUIRED: PostgreSQL password ===
PG_PASSWORD=change-me-to-a-random-password

# === REQUIRED: Invite code for user registration ===
INVITE_CODE=change-me-to-a-random-invite-code

# === REQUIRED (if using Gateway admin proxy) ===
ADMIN_JWT_SECRET=change-me-to-match-gateway-jwt-secret

# === OPTIONAL ===
NODE_ENV=production
CORS_ORIGIN=http://130.17.1.90
CORE_API=http://10.129.13.78:30900
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=portal
PG_DB=portal
