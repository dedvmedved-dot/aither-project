digraph aither_arch {
    rankdir=TB;
    bgcolor="#ffffff";
    splines=ortho;
    nodesep=0.6;
    ranksep=0.8;
    
    // Black fonts everywhere
    node [fontname="Arial", fontsize=10, fontcolor="#000000", color="#000000"];
    edge [fontname="Arial", fontsize=8, fontcolor="#000000", color="#000000"];

    // ── External ──
    user [label="Пользователь\nHTTPS :10443", shape=oval, style=filled, fillcolor="#e3f2fd"];
    admin [label="Администратор\nSSH", shape=oval, style=filled, fillcolor="#f3e5f5"];

    // ── VPS1 ──
    subgraph cluster_vps1 {
        label="VPS1 · 170.168.91.95\nUbuntu 24.04";
        fontcolor="#000000";
        bgcolor="#fafafa";
        color="#000000";
        nginx_vps1 [label="nginx\n:10443 (основной)\n:30900→Gateway", shape=box, style=filled, fillcolor="#fff3e0"];
        hermes [label="Hermes Agent\nDeepSeek V4", shape=box, style="filled,dashed", fillcolor="#c8e6c9"];
    }

    // ── VPS2 ──
    subgraph cluster_vps2 {
        label="VPS2 · 130.17.1.90\nUbuntu 24.04";
        fontcolor="#000000";
        bgcolor="#fafafa";
        color="#000000";
        nginx_vps2 [label="nginx\n:80 (статика портала)", shape=box, style=filled, fillcolor="#fff3e0"];
        bff [label="Portal BFF\nFastify :3000\nserver.ts", shape=box, style=filled, fillcolor="#e8f5e9"];
        pg_portal [label="PostgreSQL 16\nпортал:5432", shape=cylinder, style=filled, fillcolor="#f3e5f5"];
        hermes_vps2 [label="Hermes Agent\nDeepSeek V4", shape=box, style="filled,dashed", fillcolor="#c8e6c9"];
    }

    // ── VPS3 ──
    subgraph cluster_vps3 {
        label="VPS3 · 89.127.217.88\nUbuntu 24.04";
        fontcolor="#000000";
        bgcolor="#f5f5f5";
        color="#000000";
        hermes_vps3 [label="Hermes Agent\nDeepSeek V4", shape=box, style="filled,dashed", fillcolor="#c8e6c9"];
    }

    // ── K8s Cluster ──
    subgraph cluster_k8s {
        label="Kubernetes v1.33.5 · VLAN 308\n10.129.13.0/24";
        fontcolor="#000000";
        bgcolor="#f0f4ff";
        color="#000000";

        subgraph cluster_n8 {
            label="n8 · control-plane\n2× RTX 6000 · 28C/56T";
            fontcolor="#000000";
            bgcolor="#fff8e1";
            color="#000000";
            gw [label="Gateway (Python)\n:8080 HTTP · :8443 mTLS", shape=box, style=filled, fillcolor="#e3f2fd"];
            vllm14 [label="vLLM 14B\nQwen2.5-Coder-14B\nTP=1", shape=box, style=filled, fillcolor="#ffcdd2"];
            pg_bill [label="PostgreSQL\nбиллинг", shape=cylinder, style=filled, fillcolor="#f3e5f5"];
            redis [label="Redis\nrate limit", shape=cylinder, style=filled, fillcolor="#ffebee"];
        }

        subgraph cluster_n7 {
            label="n7 · worker\n2× RTX 6000 · 28C/56T";
            fontcolor="#000000";
            bgcolor="#e8f5e9";
            color="#000000";
            vllm32 [label="vLLM 32B\nQwen2.5-32B-GPTQ\nTP=2", shape=box, style=filled, fillcolor="#ffcdd2"];
            chroma [label="ChromaDB\n0.5.23\nвекторная БД", shape=box, style=filled, fillcolor="#fce4ec"];
            proxy [label="chroma-proxy\n:9000\nэмбеддинги", shape=box, style="filled,dashed", fillcolor="#e1bee7"];
            prom [label="Prometheus\n+Grafana :30300", shape=box, style=filled, fillcolor="#c8e6c9"];
        }

        etcd [label="etcd\n(кластер 2/2)", shape=cylinder, style=filled, fillcolor="#d7ccc8"];
        wiki [label="Wiki Graph\n8 страниц\nConfigMap", shape=note, style=filled, fillcolor="#fff9c4"];
    }

    // ── VPN ──
    cisco [label="Cisco 815\nVPN-терминатор", shape=box, style="filled,bold", fillcolor="#ffccbc"];

    // ── Connections: External ──
    user -> nginx_vps1 [label="HTTPS"];
    admin -> hermes [label="SSH"];

    // ── VPS1 → K8s ──
    nginx_vps1 -> gw [label=":30900 HTTP\n:31785 mTLS", style=dashed];

    // ── VPS2 internal ──
    nginx_vps2 -> bff [label="proxy"];
    bff -> pg_portal [label="SQL"];

    // ── Gateway internal (n8) ──
    gw -> vllm14 [label="14B\nмодель"];
    gw -> redis [label="RPM\nTPM"];
    gw -> pg_bill [label="биллинг"];

    // ── Gateway → n7 (cross-node) ──
    gw -> vllm32 [label="32B\nмодель"];
    gw -> proxy [label="RAG\nтекст", style=dashed];
    gw -> wiki [label="keyword\nпоиск"];
    gw -> etcd [label="конфиг"];

    // ── n7 internal ──
    proxy -> chroma [label="Python\nAPI", style=bold];

    // ── VPN chain ──
    bff -> gw [label="VPN\nmTLS"];
    nginx_vps2 -> cisco [label="VPN\ntun1"];
    cisco -> n8 [label="VLAN\n308"];
    cisco -> n7 [label="VLAN\n308"];

    // ── Hermes sync ──
    hermes -> hermes_vps2 [label="SSH\nсинхр. памяти"];
    hermes -> hermes_vps3 [label="SSH\nсинхр. памяти"];
    hermes -> cisco [label="SSH"];
    hermes -> bff [label="SSH\nуправл.", style=dotted];
    hermes_vps2 -> bff [label="SSH\nдеплой"];
    hermes_vps3 -> cisco [label="SSH", style=dashed];
}
